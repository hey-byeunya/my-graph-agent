      <data key="d2">가즈오 이시구로</data>
      <data key="d3">가즈오 이시구로는 일본 태생의 영국의 소설가이다.</data>
    </edge>
    <edge source="가즈오 이시구로" target="영국" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">가즈오 이시구로</data>
      <data key="d3">가즈오 이시구로는 일본 태생의 영국의 소설가이다.</data>
    </edge>
    <edge source="가즈오 이시구로" target="부커상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">가즈오 이시구로</data>
      <data key="d3">장편 《남아 있는 나날》로 1989년에 맨부커상을 받았다.</data>
    </edge>
    <edge source="가즈오 이시구로" target="노벨 문학상" id="WON">
