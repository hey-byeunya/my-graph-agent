    <edge source="프란스 에밀 실란패" target="핀란드" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">프란스 에밀 실란패</data>
      <data key="d4">그는 핀란드의 작가이다.</data>
    </edge>
    <edge source="프란스 에밀 실란패" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">프란스 에밀 실란패</data>
      <data key="d4">1939년 핀란드 작가로는 처음 노벨 문학상을 수상하였다.</data>
    </edge>
    <edge source="프란스 에밀 실란패" target="삶과 태양" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">프란스 에밀 실란패</data>
      <data key="d4">1916년 첫 장편소설인 《삶과 태양》(Elämä ja aurinko)을 발표하였다.</data>
    </edge>
    <edge source="프란스 에밀 실란패" target="온순한 유산" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">프란스 에밀 실란패</data>
      <data key="d4">이어서는 1919년에 핀란드 내전을 소재로 한 《온순한 유산》(Hurskas kurjuus)을 발표하였다.</data>
    </edge>
    <edge source="프란스 에밀 실란패" target="젊었을 때 잠들다" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">프란스 에밀 실란패</data>
      <data key="d4">그의 가장 유명한 작품은 1931년 발표한 《젊었을 때 잠들다》(Nuorena nukkunut, 한국에는 《실리아》라는 제목으로 소개)로 영어로 번역되어 미국과 영국에서 출판되었다.</data>
    </edge>
    <edge source="프란스 에밀 실란패" target="인생의 아름다움과 고통스러움" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">프란스 에밀 실란패</data>
      <data key="d4">1945년에는 마지막 장편인 《인생의 아름다움과 고통스러움》(Ihmiselon ihanuus ja kurjuus)을 발표하였다.</data>
    </edge>
    <edge source="프랑수아 모리아크" target="프랑스" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">프랑수아 모리아크</data>
      <data key="d4">프랑수아 모리아크(François Mauriac, 1885년 10월 11일 ~ 1970년 9월 1일)는 프랑스의 소설가이다.</data>
    </edge>
    <edge source="프랑수아 모리아크" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">프랑수아 모리아크</data>
      <data key="d4">1952년에 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="프랑수아 모리아크" target="아카데미 프랑세즈" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">프랑수아 모리아크</data>
      <data key="d4">1933년 아카데미 프랑세즈 회원이 되었고</data>
    </edge>
    <edge source="프레데리크 미스트랄" target="프랑스" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">프레데리크 미스트랄</data>
      <data key="d4">프레데리크 미스트랄(프랑스어: Frédéric Mistral, 1830년 9월 8일 ~ 1914년 3월 25일)은 19세기에 오크어 문학의 진흥을 일으킨 프로방스 출신의 시인이다.</data>
    </edge>
    <edge source="프레데리크 미스트랄" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">프레데리크 미스트랄</data>
      <data key="d4">펠리브리지 운동의 중심적 인물이었으며, 1904년 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="프레데리크 미스트랄" target="펠리브리지" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">프레데리크 미스트랄</data>
      <data key="d4">미스트랄은 펠리브리지 운동의 중심적 인물이었으며, 1904년 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="프레데리크 미스트랄" target="오크어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">프레데리크 미스트랄</data>
      <data key="d4">미스트랄은 트루바두르들의 오크어 문학전통을 부흥하기 위해 그 자신이 오크어로 많은 작품을 썼으며, 1878년에는 2권짜리 사전을 편찬했다.</data>
    </edge>
