    <edge source="러디어드 키플링" target="영국" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">러디어드 키플링</data>
      <data key="d3">그는 인도의 봄베이에서 태어났으며, 영국의 소설가이자 시인이다.</data>
    </edge>
