    </edge>
    <edge source="나기브 마푸즈" target="아랍어" id="WROTE_IN">
      <data key="d1">WROTE_IN</data>
      <data key="d2">나기브 마푸즈</data>
      <data key="d3">나기브 마푸즈(아랍어: نجيب محفوظ, Nagīb Mahfūz, 1911년 12월 11일 - 2006년 8월 30일)은 이집트의 소설가로 1988년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="나기브 마푸즈" target="게벨라위의 아이들" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">나기브 마푸즈</data>
      <data key="d3">그가 노벨문학상을 받는데 영향을 준 ‘게벨라위의 아이들 Children of Gebelawi)’이나 훗날 영화로 만들어졌던 ‘미다크 골목(Midaq Alley·셀마 헤이엑이 주연한 멕시코산 영화 제목은 El callejon de los milagros)’ 같은 것들이 그런 예들이다.</data>
    </edge>
    <edge source="나기브 마푸즈" target="나일 강변 한담" id="AUTHORED">
      <data key="d1">AUTHORED</data>
