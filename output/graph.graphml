      <data key="d4">바르가스 요사는 1960년대에 명성을 얻었다.</data>
    </edge>
    <edge source="마리오 바르가스 요사" target="라틴 아메리카의 붐" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">마리오 바르가스 요사</data>
      <data key="d4">라틴 아메리카에서 가장 중요한 소설가와 수필가 중 한 사람이며, 라틴 아메리카의 붐 세대를 이끌어 가는 작가 중 한 사람이다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="벨기에" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">모리스 마테를링크 백작은 벨기에 겐트의 프랑스어권 집안에서 태어났다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">그는 1911년 노벨 문학상을 수상하였다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="상징주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">그는 상징주의를 대표하는 작가이자 침묵과 죽음 및 불안의 극작가로 불리기도 한다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="프랑스어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">프랑스어가 모국어였고 가정교사에게 영어와 독일어를 배웠으며 8살 때 셰익스피어를 접했다고 한다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="무고한 자들의 학살" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">그는 자신의 첫 산문 작품인 ＜무고한 자들의 학살(Le Massacre des Innocents)＞(1886년 5월)을 발표한다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="온실" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">그는 또 파리에 체류하며 쓴 일련의 시를 모아 ≪온실(Serres chaudes)≫(1889)을 발표하는데 메테르링크는 이 시집이 베를렌, 랭보, 라포르그, 휘트먼 등의 영향을 받은 것이라고 고백한다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="말렌 공주" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">이어 그의 첫 희곡 ＜말렌 공주(La Prin- cesse Maleine)＞(1889)를 발표하였으며 셰익스피어, 포, 반 레르베르크의 영향을 받은 이 작품은 옥타브 미르보의 ＜피가로＞ 기사를 통해 유명해진다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="빈자의 보물" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">1896년에는 수필집 ≪빈자의 보물(Le Trésor des humbles)≫을 발표하였다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="파랑새" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">1908년 스타니슬랍스키가 연출한 ＜파랑새(L'Oiseau bleu)＞ 공연으로 대중에게 널리 알려지게 된다.</data>
    </edge>
    <edge source="모옌" target="중화인민공화국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">모옌</data>
      <data key="d4">모옌(중국어: 莫言, 병음: Mò Yán, 한자음: 막언, 1955년 2월 17일 ~ )은 중화인민공화국의 소설가이다.</data>
    </edge>
    <edge source="모옌" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">모옌</data>
