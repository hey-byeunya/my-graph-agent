    <edge source="카를 아돌프 기엘레루프" target="덴마크" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">카를 아돌프 기엘레루프</data>
      <data key="d4">카를 아돌프 기엘레루프(덴마크어: Karl Adolph Gjellerup, 1857년 6월 2일 ~ 1919년 10월 11일)는 덴마크의 시인이자 소설가로, 스칸디나비아 문학의 ‘현대적 돌파’ 시기에 활동했다.</data>
    </edge>
    <edge source="카를 아돌프 기엘레루프" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">카를 아돌프 기엘레루프</data>
      <data key="d4">1917년에 동포인 헨리크 폰토피단과 함께 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="카를 아돌프 기엘레루프" target="덴마크어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">카를 아돌프 기엘레루프</data>
      <data key="d4">그는 1900년 무렵부터 덴마크어 대신 독일어로만 작품을 쓰기 시작했으며, 독일어가 예술가로서의 발전에 도움이 된다고 생각했다.</data>
    </edge>
    <edge source="카를 아돌프 기엘레루프" target="Germanernes Lærling" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">카를 아돌프 기엘레루프</data>
      <data key="d4">초기 대표작으로는 자전적 성격의 소설 《Germanernes Lærling》(1882년)</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="스페인" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">카밀로 호세 셀라</data>
      <data key="d4">제1대 이리아플라비아 후작 카밀로 호세 셀라 이 트룰로크(Camilo José Cela y Trulock, 1st Marquis of Iria Flavia, 1916년 5월 11일 ~ 2002년 1월 17일)은 스페인의 소설가이자 1989년 노벨 문학상 수상자이다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">카밀로 호세 셀라</data>
      <data key="d4">그는 1989년 스페인에서는 다섯 번째로, 소설가로는 처음으로 노벨 문학상을 수상하게 된다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="빠스꾸알 두아르떼의 가족" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">카밀로 호세 셀라</data>
      <data key="d4">1942년 『빠스꾸알 두아르떼의 가족』은 전후의 소설사에 있어서 첫 번째 큰 사건이었다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="벌집" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">카밀로 호세 셀라</data>
      <data key="d4">1951년에 출간된 『벌집』은 대단원의 결말도 없는 작품이다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="알까리아로의 여행" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">카밀로 호세 셀라</data>
      <data key="d4">그리고 1946년 6월 6일에서 15일까지 알까리아로 여행을 하는데 이 곳에 그가 겪은 이야기들은 1948년 출판한 《알까리아로의여행 Viaje a la Alcarria》에 그 내용이 담겨있다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="콜드웰 부인이 아들과 나누는 대화" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">카밀로 호세 셀라</data>
      <data key="d4">죽은 아들 때문에 미쳐버린 여인이 아들에게 보내는 상상속의 편지들의 내용을 담은 이 소설은 내부 독백을 통한 잠재의식의 표출했다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="라 까띠라" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">카밀로 호세 셀라</data>
      <data key="d4">이 작품은 카밀로 호세 셀라가 스페인 비평문학상을 받은 작품으로 중남미 스페인어로 씌어진 리얼리즘 계열의 작품이다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="1936년, 산 까밀로" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">카밀로 호세 셀라</data>
      <data key="d4">스페인 내전이전의 사회적 분위기를 기술한 작품이다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="두 명의 사자를 위한 마수르카" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">카밀로 호세 셀라</data>
      <data key="d4">살인과 복수극을 초현실주의 기법으로 찬란한 이미지속에 전개한 전율주의의 블랙유머적 품위와 함께 독자를 끝없이 매료하고 있다.</data>
    </edge>
    <edge source="케르테스 임레" target="헝가리" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">케르테스 임레</data>
      <data key="d4">그는 헝가리의 소설가이다.</data>
    </edge>
    <edge source="케르테스 임레" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">케르테스 임레</data>
      <data key="d4">그는 2002년에 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="케르테스 임레" target="헝가리어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">케르테스 임레</data>
      <data key="d4">그는 1953년에 작가 겸 번역가로 활동하기 시작했다.</data>
    </edge>
    <edge source="케르테스 임레" target="운명" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">케르테스 임레</data>
      <data key="d4">1975년에 자신의 첫 소설인 《운명 (헝가리어: Sorstalanság)》을 발표했다.</data>
    </edge>
    <edge source="케르테스 임레" target="좌절" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">케르테스 임레</data>
      <data key="d4">그의 대표 작품으로 《좌절 (헝가리어: A kudarc)》 (1988년 작) 등이 있다.</data>
    </edge>
    <edge source="케르테스 임레" target="태어나지 않은 아이를 위한 기도" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">케르테스 임레</data>
      <data key="d4">그의 대표 작품으로 《태어나지 않은 아이를 위한 기도 (헝가리어: Kaddis a meg nem született gyermekért)》 (1990년 작) 등이 있다.</data>
    </edge>
    <edge source="케르테스 임레" target="청산" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">케르테스 임레</data>
      <data key="d4">그의 대표 작품으로 《청산 (헝가리어: Felszámolás)》 (2003년 작) 등이 있다.</data>
    </edge>
    <edge source="크누트 함순" target="노르웨이" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">크누트 함순</data>
      <data key="d4">노르웨이의 소설가이다.</data>
    </edge>
    <edge source="크누트 함순" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">크누트 함순</data>
      <data key="d4">1920년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="크누트 함순" target="굶주림" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">크누트 함순</data>
      <data key="d4">1890년에 소설 《굶주림》을 발표했다.</data>
    </edge>
    <edge source="크누트 함순" target="여왕 타마라" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">크누트 함순</data>
      <data key="d4">이 때의 경험을 바탕으로 연극 《여왕 타마라》를 썼다.</data>
    </edge>
    <edge source="크누트 함순" target="신비" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">크누트 함순</data>
      <data key="d4">작품에 소설 《신비》, 《처녀지》와 희곡 《제국의 문턱에서》, 《투쟁 생활》 등이 있다.</data>
    </edge>
    <edge source="크누트 함순" target="풀이 무성한 길에서" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">크누트 함순</data>
      <data key="d4">1949년 마지막 작품인 《풀이 무성한 길에서》(노르웨이어: På gjengrodde stier)를 출간한 함순은 1952년 그림스타드에 있는 자택 뇌어홀름(노르웨이어: Nørholm)에서 사망했다.</data>
    </edge>
    <edge source="크러스너호르커이 라슬로" target="헝가리" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">크러스너호르커이 라슬로</data>
      <data key="d4">크러스너호르커이 라슬로(헝가리어: Krasznahorkai László, 1954년 1월 5일 ~ )는 헝가리의 소설가로, 포스트모더니즘과 디스토피아 정서를 주로 다룬다.</data>
    </edge>
    <edge source="크러스너호르커이 라슬로" target="국제 부커상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">크러스너호르커이 라슬로</data>
      <data key="d4">2015년 국제 부커상 수상을 거쳐 2025년 노벨문학상을 수상하였다.</data>
    </edge>
    <edge source="크러스너호르커이 라슬로" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">크러스너호르커이 라슬로</data>
      <data key="d4">2015년 국제 부커상 수상을 거쳐 2025년 노벨문학상을 수상하였다.</data>
    </edge>
    <edge source="크러스너호르커이 라슬로" target="사탄탱고" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">크러스너호르커이 라슬로</data>
      <data key="d4">그의 주요 작품으로는 《사탄탱고》(1985)와 《저항의 멜랑콜리》(1989)가 있으며, 이들 작품은 영화감독 벨라 타르에 의해 장편영화로 각색되었다.</data>
    </edge>
    <edge source="크러스너호르커이 라슬로" target="저항의 멜랑콜리" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">크러스너호르커이 라슬로</data>
      <data key="d4">그의 주요 작품으로는 《사탄탱고》(1985)와 《저항의 멜랑콜리》(1989)가 있으며, 이들 작품은 영화감독 벨라 타르에 의해 장편영화로 각색되었다.</data>
    </edge>
    <edge source="크러스너호르커이 라슬로" target="헝가리어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">크러스너호르커이 라슬로</data>
      <data key="d4">크러스너호르커이 라슬로(헝가리어: Krasznahorkai László, 1954년 1월 5일 ~ )는 헝가리의 소설가로, 포스트모더니즘과 디스토피아 정서를 주로 다룬다.</data>
    </edge>
    <edge source="클로드 시몽" target="프랑스" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">클로드 시몽</data>
      <data key="d4">클로드 시몽은 노벨 문학상을 받은 프랑스의 작가이다.</data>
    </edge>
    <edge source="클로드 시몽" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">클로드 시몽</data>
      <data key="d4">1985년 노벨 문학상은 “자신의 소설 속에서 인간의 조건을 묘사하는데 있어 시간을 깊이 의식하며 시인과 화가의 창의성을 양립시킨” 시몽에게 수여되었다.</data>
    </edge>
    <edge source="클로드 시몽" target="누보로망" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">클로드 시몽</data>
      <data key="d4">클로드 시몽은 누보로망의 대표적 작가로, 초기에는 《협잡꾼》(1965)과 같은 전통적 수법의 작품을 쓰기도 했으나 《바람》(1957) 이후 작풍(作風)을 급회전하였으며 제2차 세계 대전을 소재로 한 《플랑드르로 가는 길》(1950), 스페인 내전을 무대로 한 《팔라스》(1962)를 연이어 발표하였다.</data>
    </edge>
    <edge source="클로드 시몽" target="협잡꾼" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">클로드 시몽</data>
      <data key="d4">시몽은 &lt;리베라시옹&gt;에 게재된 자신의 첫 소설,  《협잡꾼》으로 문학계에 첫 발을 내딛는다.</data>
    </edge>
    <edge source="클로드 시몽" target="플랑드르로 가는 길" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">클로드 시몽</data>
      <data key="d4">시몽의 소설 《플랑드르로 가는 길》은 1960년 렉스프레스상을 수상하였다.</data>
    </edge>
    <edge source="클로드 시몽" target="역사" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">클로드 시몽</data>
      <data key="d4">1967년, 시몽은 자신의 가장 유명한 작품 중 하나인 《역사》로 메디시상을 수상하였다.</data>
    </edge>
    <edge source="클로드 시몽" target="레 제오르지크Les Géorgiques" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">클로드 시몽</data>
      <data key="d4">1981년 : 《레 제오르지크Les Géorgiques》, 미뉘 출판사</data>
    </edge>
    <edge source="테오도어 몸젠" target="독일" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">테오도어 몸젠</data>
      <data key="d4">크리스티안 마티아스 테오도어 몸젠(Christian Matthias Theodor Mommsen, 1817년 11월 30일 ~ 1903년 11월 1일)은 독일의 고전학자이다.</data>
    </edge>
    <edge source="테오도어 몸젠" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">테오도어 몸젠</data>
      <data key="d4">그는 1902년에 노벨 문학상을 수상했는데, 역사가가 노벨 문학상을 수상한 것은 현재까지 그가 유일하다.</data>
    </edge>
    <edge source="테오도어 몸젠" target="로마사" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">테오도어 몸젠</data>
      <data key="d4">그의 저서로 《로마사》(A History Of Rome)가 있다.</data>
    </edge>
    <edge source="로마사" target="비문학" id="HAS_GENRE">
      <data key="d2">HAS_GENRE</data>
      <data key="d3">테오도어 몸젠</data>
      <data key="d4">역사 저술로 1902년 노벨 문학상을 받은 몇 안 되는 비문학 작가 가운데 한 명이다.</data>
    </edge>
    <edge source="토니 모리슨" target="미국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">토니 모리슨</data>
      <data key="d4">모리슨은 미국 오하이오주 로레인에서 태어났다.</data>
    </edge>
    <edge source="토니 모리슨" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">토니 모리슨</data>
      <data key="d4">1993년 노벨 문학상을 수상했다.</data>
    </edge>
