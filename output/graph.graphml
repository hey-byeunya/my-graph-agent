      <data key="d1">AUTHORED</data>
      <data key="d2">올가 토카르추크</data>
      <data key="d3">소설 《방랑자들》로 2018년 국제 부커상을 수상했으며...</data>
    </edge>
    <edge source="올가 토카르추크" target="태고의 시간들" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">올가 토카르추크</data>
      <data key="d3">대표작으로 《태고의 시간들》, 《죽은 자들의 뼈 위로 쟁기를 끌어라》, 《야쿠프의 이야기》 등이 있다.</data>
    </edge>
