      <data key="d2">BELONGS_TO</data>
      <data key="d3">해럴드 핀터</data>
      <data key="d4">해럴드 핀터는 영국의 극작가로, 사뮈엘 베케트와 비견되며 부조리 연극의 대표적인 작가로 꼽힌다.</data>
    </edge>
    <edge source="헤르만 헤세" target="스위스" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">헤르만 헤세</data>
      <data key="d4">헤르만 카를 헤세(독일어: Hermann  Karl Hesse, 1877년 7월 2일 ~ 1962년 8월 9일)는 독일계 스위스인이며, 시인, 소설가, 화가이다.</data>
    </edge>
    <edge source="헤르만 헤세" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">헤르만 헤세</data>
      <data key="d4">1946년 유리알 유희로 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="헤르만 헤세" target="독일어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">헤르만 헤세</data>
      <data key="d4">헤르만 카를 헤세(독일어: Hermann  Karl Hesse, 1877년 7월 2일 ~ 1962년 8월 9일)는 독일계 스위스인이며, 시인, 소설가, 화가이다.</data>
    </edge>
    <edge source="헤르만 헤세" target="페터 카멘찐트" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">헤르만 헤세</data>
      <data key="d4">1904년 『페터 카멘친트(향수)』를 통해 헤세는 일약 독일어권에서 유명한 작가가 되며, 이후 그는 성공적인 작가의 길을 걷게 된다.</data>
    </edge>
    <edge source="헤르만 헤세" target="수레바퀴 아래서" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">헤르만 헤세</data>
      <data key="d4">신학교 때의 경험은 소설 《수레바퀴 밑에서》에서 비판적으로 묘사되었다.</data>
    </edge>
    <edge source="헤르만 헤세" target="데미안" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">헤르만 헤세</data>
      <data key="d4">이때 나온 작품이 『데미안』이다.</data>
    </edge>
    <edge source="헤르만 헤세" target="유리알 유희" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">헤르만 헤세</data>
      <data key="d4">1946년 유리알 유희로 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="헤르만 헤세" target="낭만주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">헤르만 헤세</data>
      <data key="d4">그는 헤세를 '찬란한 낭만주의 대열의 마지막 기사(騎士)라고 표현했다.</data>
    </edge>
    <edge source="헤르만 헤세" target="싯다르타" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">헤르만 헤세</data>
      <data key="d4">1922년《싯다르타 Siddhartha》</data>
    </edge>
