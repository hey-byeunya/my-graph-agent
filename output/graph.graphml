    <edge source="미하일 숄로호프" target="러시아" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">미하일 숄로호프</data>
      <data key="d3">소련의 소설가이자 노벨 문학상 수상자이다.</data>
    </edge>
    <edge source="미하일 숄로호프" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">미하일 숄로호프</data>
      <data key="d3">마침내 1965년 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="미하일 숄로호프" target="레닌 상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">미하일 숄로호프</data>
      <data key="d3">문학상의 공로를 인정받아 레닌 상을 받았고,</data>
    </edge>
    <edge source="미하일 숄로호프" target="스탈린 상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">미하일 숄로호프</data>
      <data key="d3">《조용한 돈강》은 스탈린 상을 받았다.</data>
    </edge>
    <edge source="미하일 숄로호프" target="조용한 돈강" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">미하일 숄로호프</data>
      <data key="d3">러시아 문학의 최고 걸작 중 하나인 《조용한 돈강》의 집필에 착수하여,</data>
    </edge>
    <edge source="미하일 숄로호프" target="인간의 운명" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">미하일 숄로호프</data>
      <data key="d3">전쟁의 비극과 전쟁 고아에 대한 인간애를 그린 《인간의 운명》이 있다.</data>
    </edge>
    <edge source="미하일 숄로호프" target="그들은 조국을 위해 싸웠다" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">미하일 숄로호프</data>
      <data key="d3">1946년 러시아군의 위력을 예술적으로 묘사한 《그들은 조국을 위해 싸웠다》를 저술하였다.</data>
    </edge>
    <edge source="미하일 숄로호프" target="증오의 과학" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">미하일 숄로호프</data>
      <data key="d3">1942년 파시스트에 대한 증오와 애국적인 감정을 고취시킨 단편 〈증오의 과학〉을 발표하였다.</data>
    </edge>
    <edge source="미하일 숄로호프" target="새끼 말" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">미하일 숄로호프</data>
      <data key="d3">1923년 첫 작품 《새끼 말》을 발표하였으며,</data>
    </edge>
    <edge source="미하일 숄로호프" target="돈 강의 이야기" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">미하일 숄로호프</data>
      <data key="d3">이어 〈돈 강의 이야기〉, 〈유리색의 황야〉 등 20여 편의 단편을 발표하였다.</data>
    </edge>
    <edge source="버트런드 러셀" target="영국" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">버트런드 러셀</data>
      <data key="d3">그는 웨일스에서 태어났고 그곳에서 사망했다.</data>
    </edge>
    <edge source="버트런드 러셀" target="노벨 문학상" id="WON">
