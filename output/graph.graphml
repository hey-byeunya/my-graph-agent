      <data key="d3">그는 수학자로서 출발하여 《수학 원리》를 통해 수리 철학 및 기호 논리학에 공헌하였다.</data>
    </edge>
    <edge source="버트런드 러셀" target="영어" id="WROTE_IN">
      <data key="d1">WROTE_IN</data>
      <data key="d2">버트런드 러셀</data>
      <data key="d3">그의 저술은 논리학, 수학, 집합론, 언어학, 철학중에서도 언어철학, 인식론, 형이상학에 영향을 주었다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="스웨덴" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">베르네르 폰 헤이덴스탐</data>
      <data key="d3">스웨덴의 시인·소설가이다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">베르네르 폰 헤이덴스탐</data>
      <data key="d3">1916년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="스웨덴어" id="WROTE_IN">
      <data key="d1">WROTE_IN</data>
      <data key="d2">베르네르 폰 헤이덴스탐</data>
      <data key="d3">스웨덴의 시인·소설가이다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="자연주의" id="BELONGS_TO">
      <data key="d1">BELONGS_TO</data>
      <data key="d2">베르네르 폰 헤이덴스탐</data>
      <data key="d3">당시의 자연주의 문학에 반항(反抗)한 그는 소설 &lt;한스 알리에누스&gt;로서 편력(遍歷) 끝에 안주(安住)의 땅을 고향에서 발견하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="하나의 민족" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">베르네르 폰 헤이덴스탐</data>
      <data key="d3">애국시집 &lt;하나의 민족&gt; 가운데의 1편인 &lt;스웨덴&gt;은 제2국가(國歌)로서 지금도 불리고 있다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="순례와 편력의 세월" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">베르네르 폰 헤이덴스탐</data>
      <data key="d3">1888년 첫 작품 &lt;순례와 편력의 세월&gt;에서 동방인의 방일(放逸)하고 소박한 생활의 환희를 노래하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="한스 알리에누스" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">베르네르 폰 헤이덴스탐</data>
      <data key="d3">소설 &lt;한스 알리에누스&gt;로서 편력(遍歷) 끝에 안주(安住)의 땅을 고향에서 발견하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="카를 왕의 군대" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">베르네르 폰 헤이덴스탐</data>
      <data key="d3">이 열정은 스웨덴과 러시아 제국 간의 대북방 전쟁에서 병사들의 충성을 그린 &lt;카를 왕의 군대&gt;(1898)에서 그 정점에 도달된다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="숲은 술렁인다" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">베르네르 폰 헤이덴스탐</data>
      <data key="d3">그는 다시 &lt;숲은 술렁인다&gt; &lt;성(聖) 게오르게와 용(龍)&gt;에서 조국에의 사랑과 희생적 정신을 높이 제창하고.</data>
    </edge>
