      <data key="d2">AUTHORED</data>
      <data key="d3">앙드레 지드</data>
      <data key="d4">주요 작품은 1909년에 발표한 《좁은 문》, 《이자벨》, 《교황청의 지하도》 등이 있으며...</data>
    </edge>
    <edge source="앙드레 지드" target="전원교향악" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">앙드레 지드</data>
      <data key="d4">제1차 세계대전 후에는 《전원 교향악》, 《보리 한 알이 죽지 않으면》 등이 있다.</data>
    </edge>
    <edge source="앙드레 지드" target="콩고 기행" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">앙드레 지드</data>
      <data key="d4">1927년에 발표한 《콩고 기행》은 비평가로서의 그를 높이 인정할 수 있는 작품이며...</data>
    </edge>
    <edge source="앙드레 지드" target="소련 기행" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">앙드레 지드</data>
      <data key="d4">소련을 여행한 후 쓴 《소련 기행》은 좌파 언론계의 공격을 받기도 하였다.</data>
    </edge>
    <edge source="앙드레 지드" target="프랑스어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">앙드레 지드</data>
      <data key="d4">앙드레 지드(프랑스어: Andre Paul Guillaume Gide, 1869년 11월 22일 ~ 1951년 2월 19일)는 프랑스의 소설가·비평가이다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="덴마크" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">요하네스 빌헬름 옌센</data>
      <data key="d4">덴마크의 소설가이다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">요하네스 빌헬름 옌센</data>
      <data key="d4">그 결과 구약성서, 스칸디나비아 신화, 아이슬란드의 사가 등을 이용하여 지질학·인류학·고고학·민족학의 지식을 바탕으로 서술하여 소년시절의 회상이나 그가 얻은 많은 여행에서의 인상도 집어넣고 있다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="긴 여행" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">요하네스 빌헬름 옌센</data>
      <data key="d4">노벨 문학상(1944)의 대상이 되었던 &lt;긴 여행(旅行)&gt;(1909-21)이다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="덴마크어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">요하네스 빌헬름 옌센</data>
      <data key="d4">덴마크 초기 모더니즘의 대표 작가로 자리 잡았으며, 소설·단편·시 외에도 희곡과 인류학·진화 철학에 관한 수필을 썼다.</data>
    </edge>
    <edge source="조수에 카르두치" target="이탈리아" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">조수에 카르두치</data>
      <data key="d4">이탈리아의 시인·고전문학자이다.</data>
    </edge>
    <edge source="조수에 카르두치" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">조수에 카르두치</data>
      <data key="d4">1906년에는 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="조수에 카르두치" target="낭만주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">조수에 카르두치</data>
      <data key="d4">그는 낭만주의에 맞선 문학 모임 ‘아미치 페단티’를 친구들과 결성했다.</data>
    </edge>
    <edge source="조수에 카르두치" target="민중의 하프" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">조수에 카르두치</data>
      <data key="d4">1855년 카르두치는 학교용 이탈리아 시 선집 《민중의 하프》를 출판했다.</data>
    </edge>
    <edge source="조수에 카르두치" target="유베닐리아" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">조수에 카르두치</data>
      <data key="d4">초기 시집 《유베닐리아》는 단테·페트라르카와 고전 시형식의 영향을 보여 주며.</data>
    </edge>
    <edge source="모리스 마테를링크" target="벨기에" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">모리스 마테를링크 백작은 벨기에 겐트의 프랑스어권 집안에서 태어났다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">그는 1911년 노벨 문학상을 수상하였다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="상징주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">그는 상징주의를 대표하는 작가이자 침묵과 죽음 및 불안의 극작가로 불리기도 한다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="프랑스어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">모리스 폴리도르 마리 베르나르 마테를링크(프랑스어: Count Maurice Polydore Marie Bernard Maeterlinck, 1862년 8월 29일 ~ 1949년 5월 6일) 백작은 벨기에의 시인이자, 극작가, 수필가이다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="무고한 자들의 학살" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">그는 1886년 3월 마테를링크는 파리에서 만난 젊은 시인들과 잡지 ＜라 플레이아드(La Pléiade)＞를 창간하였고 여기에 자신의 첫 산문 작품인 ＜무고한 자들의 학살(Le Massacre des Innocents)＞(1886년 5월)을 발표한다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="온실" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">그는 또 파리에 체류하며 쓴 일련의 시를 모아 ≪온실(Serres chaudes)≫(1889)을 발표하는데 메테르링크는 이 시집이 베를렌, 랭보, 라포르그, 휘트먼 등의 영향을 받은 것이라고 고백한다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="말렌 공주" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">이어 그의 첫 희곡 ＜말렌 공주(La Prin- cesse Maleine)＞(1889)를 발표하였으며 셰익스피어, 포, 반 레르베르크의 영향을 받은 이 작품은 옥타브 미르보의 ＜피가로＞ 기사를 통해 유명해진다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="빈자의 보물" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">1896년에는 수필집 ≪빈자의 보물(Le Trésor des humbles)≫을 발표하였고, 1908년 스타니슬랍스키가 연출한 ＜파랑새(L'Oiseau bleu)＞ 공연으로 대중에게 널리 알려지게 된다.</data>
    </edge>
    <edge source="모리스 마테를링크" target="파랑새" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">모리스 마테를링크</data>
      <data key="d4">그의 가장 큰 성공은 동화극인 〈파랑새〉이다.</data>
    </edge>
    <edge source="생존 페르스" target="프랑스" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">프랑스의 시인·외교관이다.</data>
    </edge>
    <edge source="생존 페르스" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">1960년 노벨 문학상을 받았으며</data>
    </edge>
    <edge source="생존 페르스" target="원정" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">작품으로 《원정》, 《유적》, 《편년사》 등이 있다.</data>
    </edge>
    <edge source="생존 페르스" target="유적" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">작품으로 《원정》, 《유적》, 《편년사》 등이 있다.</data>
    </edge>
    <edge source="생존 페르스" target="편년사" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">작품으로 《원정》, 《유적》, 《편년사》 등이 있다.</data>
    </edge>
    <edge source="생존 페르스" target="찬가" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">작품 &lt;찬가(讚歌)&gt;(1911)은 서인도 제도의 남국 정취가 풍기는 풍물과 그곳에서 지낸 유년시절을 그렸다.</data>
    </edge>
    <edge source="생존 페르스" target="아나바스" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">외교관으로 근무하면서 베이징(北京)에 있을 때 외몽골과 중앙아시아를 탐험하여 &lt;아나바스&gt;(1924), &lt;태자친선(太子親善)&gt;(1924)을 썼다.</data>
    </edge>
    <edge source="생존 페르스" target="태자친선" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">외교관으로 근무하면서 베이징(北京)에 있을 때 외몽골과 중앙아시아를 탐험하여 &lt;아나바스&gt;(1924), &lt;태자친선(太子親善)&gt;(1924)을 썼다.</data>
    </edge>
    <edge source="생존 페르스" target="유적지" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">미국에서 망명자의 부재감, 전쟁에 대한 고뇌의 선율을 읊은 &lt;유적지(流謫地)&gt;(1946)를 출간했다.</data>
    </edge>
    <edge source="생존 페르스" target="바람" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">전후 귀국하지 않고 남아메리카와 카리브해를 배경으로 내재한 심오한 세계를 &lt;바람&gt;(1949), &lt;항해 목표&gt;(1957)에서 노래했다.</data>
    </edge>
    <edge source="생존 페르스" target="항해 목표" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">전후 귀국하지 않고 남아메리카와 카리브해를 배경으로 내재한 심오한 세계를 &lt;바람&gt;(1949), &lt;항해 목표&gt;(1957)에서 노래했다.</data>
    </edge>
    <edge source="생존 페르스" target="연대기" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">생존 페르스</data>
      <data key="d4">그 후에도 &lt;연대기(年代記)&gt;(1960)와 &lt;새&gt;(1961)를 출판하였다.</data>
    </edge>
    <edge source="나기브 마푸즈" target="이집트" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">나기브 마푸즈</data>
      <data key="d4">나기브 마푸즈는 이집트의 소설가로 1988년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="나기브 마푸즈" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">나기브 마푸즈</data>
      <data key="d4">나기브 마푸즈는 이집트의 소설가로 1988년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="나기브 마푸즈" target="실존주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">나기브 마푸즈</data>
      <data key="d4">분류: 1911년 출생, 2006년 사망, 노벨 문학상 수상자, 실존주의자, 이집트의 노벨상 수상자, 이집트의 사회주의자, 이집트의 소설가, 카이로 대학교 동문, 카이로 출신</data>
    </edge>
    <edge source="나기브 마푸즈" target="아랍어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">나기브 마푸즈</data>
      <data key="d4">현재 아랍어권 작가로서는 유일한 노벨 문학상 수상자이다.</data>
    </edge>
    <edge source="나기브 마푸즈" target="게벨라위의 아이들" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">나기브 마푸즈</data>
      <data key="d4">그가 노벨문학상을 받는데 영향을 준 ‘게벨라위의 아이들 Children of Gebelawi)’이나 훗날 영화로 만들어졌던 ‘미다크 골목(Midaq Alley·셀마 헤이엑이 주연한 멕시코산 영화 제목은 El callejon de los milagros)’ 같은 것들이 그런 예들이다.</data>
    </edge>
    <edge source="나기브 마푸즈" target="나일 강변 한담" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">나기브 마푸즈</data>
      <data key="d4">마푸즈의 또다른 대표작 '나일 강변 한담 Chitchat on the Nile'(1966)도 수난을 당하기는 마찬가지였다.</data>
    </edge>
