    <edge source="하뤼 마르틴손" target="스웨덴" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">하뤼 마르틴손</data>
      <data key="d3">하뤼 마르틴손(Harry Martinson, 1904년 5월 6일 ~ 1978년 2월 11일)은 스웨덴의 작가·시인이자 전직 선원이다.</data>
    </edge>
    <edge source="하뤼 마르틴손" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">하뤼 마르틴손</data>
      <data key="d3">1974년 노벨 문학상을 공동 수상했다.</data>
    </edge>
    <edge source="하뤼 마르틴손" target="아니아라" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">하뤼 마르틴손</data>
      <data key="d3">대표작 가운데 하나인 시 연작 아니아라는 우주 여행 중 항로를 잃고 목적지 없이 떠도는 우주선 아니아라의 이야기다.</data>
    </edge>
    <edge source="하뤼 마르틴손" target="케이프여 안녕" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">하뤼 마르틴손</data>
      <data key="d3">이 경험은 자전적 작품인 《케이프여 안녕》과 《길》을 비롯한 그의 문학에 배경을 제공했으며...</data>
    </edge>
    <edge source="하뤼 마르틴손" target="유령선" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">하뤼 마르틴손</data>
      <data key="d3">1929년 첫 시집 《유령선》을 펴냈고...</data>
    </edge>
    <edge source="하뤼 마르틴손" target="유목민" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">하뤼 마르틴손</data>
      <data key="d3">1931년 시집 《유목민》으로 문학적 돌파구를 마련했다.</data>
    </edge>
    <edge source="하뤼 마르틴손" target="목적 없는 여행" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">하뤼 마르틴손</data>
      <data key="d3">선원 생활을 다룬 산문집 《목적 없는 여행》과 《케이프여 안녕》은 그를 스웨덴의 주요 작가로 자리매김하게 했다.</data>
    </edge>
    <edge source="하뤼 마르틴손" target="스웨덴어" id="WROTE_IN">
