    </edge>
    <edge source="하뤼 마르틴손" target="아니아라" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">하뤼 마르틴손</data>
      <data key="d4">대표작 가운데 하나인 시 연작 아니아라는 우주 여행 중 항로를 잃고 목적지 없이 떠도는 우주선 아니아라의 이야기다.</data>
    </edge>
    <edge source="하뤼 마르틴손" target="케이프여 안녕" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">하뤼 마르틴손</data>
      <data key="d4">이 경험은 자전적 작품인 《케이프여 안녕》과 《길》을 비롯한 그의 문학에 배경을 제공했으며...</data>
    </edge>
    <edge source="하뤼 마르틴손" target="유령선" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">하뤼 마르틴손</data>
      <data key="d4">1929년 첫 시집 《유령선》을 펴냈고...</data>
    </edge>
    <edge source="하뤼 마르틴손" target="유목민" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">하뤼 마르틴손</data>
      <data key="d4">1931년 시집 《유목민》으로 문학적 돌파구를 마련했다.</data>
    </edge>
    <edge source="하뤼 마르틴손" target="목적 없는 여행" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">하뤼 마르틴손</data>
      <data key="d4">선원 생활을 다룬 산문집 《목적 없는 여행》과 《케이프여 안녕》은 그를 스웨덴의 주요 작가로 자리매김하게 했다.</data>
    </edge>
    <edge source="하뤼 마르틴손" target="스웨덴어" id="WROTE_IN">
