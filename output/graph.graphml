    <edge source="V. S. 나이폴" target="사회민주당" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">귄터 그라스</data>
      <data key="d4">그라스는 전후 독일 사회민주당의 주요 지지자가 되어 외국인 혐오증, 신나치주의 등에 반대하는 사회활동에 적극 참여하였다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="자연주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">그는 독일 자연주의 연극의 형성과 발전에 기여했다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="해가 뜨기 전" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">하웁트만의 첫 번째 희곡은 《해가 뜨기 전》(Vor Sonnenaufgang) (1889)으로, '자유무대'에서 초연되어 현대 독일 문학에서 자연주의 운동의 막을 연 작품이다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="직조공들" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">하웁트만의 최고걸작이라고 불리며 또한 가장 성공한 작품은 그 다음에 쓰여진 《직조공들》(Die Weber, The Weavers, 1892)이다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="하넬레의 승천" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">그것이 표면화된 것이 《하넬레의 승천(昇天)》(Hanneles Himmelfahrt, 1893)이며 1896년의 《침종(沈鍾)》에 이르러 절정이 된다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="침종" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">《침종》은 《직조공들》과 어깨를 나란히 하는 성공작이나, 가장 일찍이 그 평가를 잃은 작품이기도 했다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="Dorothea Angermann" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">초기 성공을 거둔 것과 유사한 충분한 길이의 희곡 작품인 Dorothea Angermann (1926)과 Vor Sonnenuntergang (1932)을 썼고, 거기에는 사실주의적인 취향이 나타나 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="아트리덴 사부극" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">그의 마지막 작품은 《아트리덴 사부극》Atriden-Tetralogie (1942–46)이었다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="프랑스" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">아니 에르노</data>
      <data key="d4">아니 테레즈 블랑슈 에르노(프랑스어: Annie Thérèse Blanche Ernaux, 혼전 성씨: 뒤셴·Duchesne, 1940년 9월 1일 ~ )는 프랑스의 작가이자 문학 교수, 노벨문학상 수상자다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="르노도 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">아니 에르노</data>
      <data key="d4">1984년 《아버지의 자리》로 르노도 문학상을 수상했다.</data>
    </edge>
    <edge source="버트런드 러셀" target="영국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">그는 웨일스에서 태어났고 그곳에서 사망했다.</data>
    </edge>
    <edge source="버트런드 러셀" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">1950년 노벨 문학상을 수상하였다.</data>
    </edge>
    <edge source="버트런드 러셀" target="결과주의자" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">결과주의자, 경험론자, 공리주의자, 과학철학자, 기본소득 지지자, 기술철학자, 노벨 문학상 수상자, 도덕철학자, 러셀 백작, 러셀가, 루트비히 비트겐슈타인, 메리트 훈장, 무신론 철학자, 민주사회주의자, 반국민주의자, 반스탈린주의 좌파, 버트런드 러셀, 베트남 전쟁 반전 운동가, 수리철학자, 스코틀랜드계 영국인, 시카고 대학교 교수, 아리스토텔레스주의 철학자, 언어적 전회, 영국의 노벨상 수상자, 영국의 무신론자, 영국의 반핵무기 운동가, 영국의 사회주의자, 영국의 수필가, 영국의 역사가, 영국의 저술가, 영국의 제1차 세계 대전 반전 운동가, 영국의 철학자, 왕립학회 석학회원, 웨일스계 영국인, 웨일스의 수학자, 인식론 학자, 잉글랜드의 논리학자, 잉글랜드의 무신론자, 잉글랜드의 반전 운동가, 잉글랜드의 불가지론자, 잉글랜드의 사회주의자, 잉글랜드의 성소수자 인권운동가, 잉글랜드의 자서전 작가, 잉글랜드의 평화주의자, 집합론자, 캘리포니아 대학교 로스앤젤레스 교수, 케임브리지 대학교 트리니티 칼리지 교수, 케임브리지 대학교 트리니티 칼리지 동문, 페이비언 협회 회원, 형이상학자.</data>
    </edge>
    <edge source="버트런드 러셀" target="수학 원리" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">화이트헤드와 함께 《수학 원리》를 저술하여 수리논리학의 성립에 공헌하였으며.</data>
    </edge>
    <edge source="버트런드 러셀" target="On Denoting" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">그의 철학 에세이 〈On Denoting〉은 '철학의 패러다임'으로 간주되고 있다.</data>
    </edge>
    <edge source="버트런드 러셀" target="The Principles of Mathematics" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">1903년 그는 수리논리학에 대한 첫 번째 저작인 《The Principles of Mathematics》를 발간하며.</data>
    </edge>
    <edge source="버트런드 러셀" target="A History of Western Philosophy" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">《러셀 서양철학사(A History of Western Philosophy)》, 기독교 비평서 《나는 왜 기독교인이 아닌가》를 비롯해 많은 저서를 남겼다.</data>
    </edge>
    <edge source="호세 에체가라이" target="스페인" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">호세 에체가라이</data>
      <data key="d4">호세 에체가라이 이 에이사기레(José Echegaray y Eizaguirre, 1832년 4월 19일 ~ 1916년 9월 14일)는 스페인의 토목 기술자, 수학자, 정치인이자 19세기 후반 스페인을 대표하는 극작가이다.</data>
    </edge>
    <edge source="호세 에체가라이" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">호세 에체가라이</data>
      <data key="d4">그는 1904년에 프랑스의 시인 프레데리크 미스트랄과 함께 노벨 문학상을 수상했으며 스페인인으로는 처음으로 노벨상을 수상했다.</data>
    </edge>
    <edge source="호세 에체가라이" target="광인인가 성인인가" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">호세 에체가라이</data>
      <data key="d4">그의 대표 작품으로 《광인인가 성인인가 (O locura o santidad)》, 《위대한 갈레오토 (El Gran Galeoto)》가 있다.</data>
    </edge>
    <edge source="호세 에체가라이" target="위대한 갈레오토" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">호세 에체가라이</data>
      <data key="d4">그의 대표 작품으로 《광인인가 성인인가 (O locura o santidad)》, 《위대한 갈레오토 (El Gran Galeoto)》가 있다.</data>
    </edge>
    <edge source="호세 에체가라이" target="19세기" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">호세 에체가라이</data>
      <data key="d4">호세 에체가라이 이 에이사기레(José Echegaray y Eizaguirre, 1832년 4월 19일 ~ 1916년 9월 14일)는 스페인의 토목 기술자, 수학자, 정치인이자 19세기 후반 스페인을 대표하는 극작가이다.</data>
    </edge>
    <edge source="데릭 월컷" target="세인트루시아" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">세인트루시아의 시인이자 극작가로, 1992년 노벨 문학상 수상자이다.</data>
    </edge>
    <edge source="데릭 월컷" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">1992년 노벨 문학상 수상자이다.</data>
    </edge>
    <edge source="데릭 월컷" target="영어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">데릭 월컷(영어: Sir Derek Walcott, KCSL, OBE, 문화어: 데리크 월코트, 1930년 1월 23일 ~ 2017년 3월 17일)은 세인트루시아의 시인이자 극작가로, 1992년 노벨 문학상 수상자이다.</data>
    </edge>
    <edge source="데릭 월컷" target="푸른 밤에: 1948-1960" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">상업적으로 발간된 첫 시집은 1962년에 나온 《푸른 밤에: 1948-1960》였다.</data>
    </edge>
    <edge source="데릭 월컷" target="다른 인생" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">그 밖에 긴 이야기가 담긴 시 〈다른 인생〉(1973년) 등을 발표했다.</data>
    </edge>
    <edge source="데릭 월컷" target="별사과 왕국" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">그 밖에 긴 이야기가 담긴 시 〈별사과 왕국〉(1979년) 등을 발표했다.</data>
    </edge>
    <edge source="데릭 월컷" target="행운적 여행인" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">그 밖에 긴 이야기가 담긴 시 〈행운적 여행인〉 (1981년) 등을 발표했다.</data>
    </edge>
    <edge source="데릭 월컷" target="한 여름 중" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">그 밖에 긴 이야기가 담긴 시 〈한 여름 중〉(1984년) 등을 발표했다.</data>
    </edge>
    <edge source="데릭 월컷" target="아칸소 유언" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">그 밖에 긴 이야기가 담긴 시 〈아칸소 유언〉(1987년)과 〈하사금〉(1997년) 등을 발표했다.</data>
    </edge>
    <edge source="데릭 월컷" target="오메로스" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">〈오메로스〉(1990년)는 시인의 개인적 추억과 집단적 추억 사이에서의 내적 투쟁을 묘사하는 서사시였다.</data>
    </edge>
    <edge source="데릭 월컷" target="티에폴로의 사냥개" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">다른 서사시 〈티에폴로의 사냥개〉(2000년)는 버진 제도에서 태어난 인상주의 화가 카미유 피사로를 다루었다.</data>
    </edge>
    <edge source="데릭 월컷" target="방탕자" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">연작 시집 《방탕자》(2004년)는 그의 여행책과 저서를 겸하였다.</data>
    </edge>
    <edge source="데릭 월컷" target="원숭이 산에 대한 꿈" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">극작으로는 《원숭이 산에 대한 꿈》(1967년) 등이 있다.</data>
    </edge>
    <edge source="데릭 월컷" target="기념" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">극작으로는 《기념》(1977년) 등이 있다.</data>
    </edge>
    <edge source="데릭 월컷" target="무연극" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">극작으로는 《무연극》(1978년)과 《오디세이: 무대극판》(1993년) 등이 있다.</data>
    </edge>
    <edge source="데릭 월컷" target="동굴인" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">데릭 월컷</data>
      <data key="d4">미국의 가수 폴 사이먼과 함께 뮤지컬 《동굴인》(The Capeman, 1997년)을 쓰기도 하였다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="프랑스" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">그는 1940년 니스의 리비에라에서 영국계 아버지와 프랑스인 어머니 사이에서 태어났다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">그는 1963년 르노도 상과 2008년 노벨 문학상을 수상하였다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="프랑스어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">국적으로는 2000년 가오싱젠 이후, 언어로는 1985년 클로드 시몽 이후 첫 번째 프랑스 국적과 프랑스어 작가로서 노벨 문학상을 수상하게 되었다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="포스트모더니즘" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">그는 포스트모더니즘 작가이다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="조서" id="AUTHORED">
      <data key="d2">AUTHORED</data>
