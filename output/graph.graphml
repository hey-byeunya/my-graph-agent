    <edge source="윌리엄 골딩" target="영국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">윌리엄 골딩 경(Sir William Gerald Golding, CBE, 1911년 9월 19일 ~ 1993년 6월 19일)은 영국의 소설가, 극작가이자 시인이다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">1983년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="부커상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">1980년에는 바다 3부작 《땅 끝까지》의 첫 소설인 《성인 의식》으로 부커상을 받았고, 1983년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="왕립문학회" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">문학에 기여한 공로로 1988년 기사 작위를 받았으며, 왕립문학회 회원이기도 했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="파리대왕" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">그의 데뷔 소설 《파리대왕》(1954)은 가장 잘 알려진 작품이며, 평생 소설 12권을 더 출판했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="통과 의례" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">그는 평생 12권의 소설을 발표했고, 《통과 의례》로 시작하는 해양 3부작 《지구 끝까지》로 1980년 부커상을 받았다.</data>
    </edge>
    <edge source="카를 아돌프 기엘레루프" target="덴마크" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">카를 아돌프 기엘레루프</data>
      <data key="d4">카를 아돌프 기엘레루프는 덴마크의 시인이자 소설가로, 스칸디나비아 문학의 ‘현대적 돌파’ 시기에 활동했다.</data>
    </edge>
    <edge source="카를 아돌프 기엘레루프" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">카를 아돌프 기엘레루프</data>
      <data key="d4">1917년에 동포인 헨리크 폰토피단과 함께 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="카를 아돌프 기엘레루프" target="덴마크어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
