    <edge source="올가 토카르추크" target="폴란드어" id="WROTE_IN">
      <data key="d1">WROTE_IN</data>
      <data key="d2">올가 토카르추크</data>
      <data key="d3">올가 나보야 토카르추크(폴란드어: Olga Nawoja Tokarczuk, 1962년 1월 29일~)는 폴란드의 작가, 활동가이자 공적 지식인이다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="덴마크" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">요하네스 빌헬름 옌센</data>
      <data key="d3">덴마크의 소설가이다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">요하네스 빌헬름 옌센</data>
      <data key="d3">그 결과 구약성서, 스칸디나비아 신화, 아이슬란드의 사가 등을 이용하여 지질학·인류학·고고학·민족학의 지식을 바탕으로 서술하여 소년시절의 회상이나 그가 얻은 많은 여행에서의 인상도 집어넣고 있다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="긴 여행" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">요하네스 빌헬름 옌센</data>
      <data key="d3">후에 세계일주 여행길에 일본에 기착하여 1906년 신화 《후지산(富士山)》을 발표했으며 다양한 그의 작가활동 중에서 한 가지를 들어 본다면 노벨 문학상(1944)의 대상이 되었던 &lt;긴 여행(旅行)&gt;(1909-21)이다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="덴마크어" id="WROTE_IN">
      <data key="d1">WROTE_IN</data>
      <data key="d2">요하네스 빌헬름 옌센</data>
      <data key="d3">덴마크의 소설가이다.</data>
    </edge>
    <edge source="욘 포세" target="노르웨이" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">욘 포세</data>
      <data key="d3">욘 올라브 포세(노르웨이어: Jon Olav Fosse, 1959년 9월 29일 ~ )는 노르웨이의 문학가이다.</data>
    </edge>
    <edge source="욘 포세" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">욘 포세</data>
      <data key="d3">2023년에 "말할 수 없는 것에 목소리를 부여하는 혁신적인 희곡과 산문"을 발표한 공로를 인정받아 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="욘 포세" target="희곡" id="HAS_GENRE">
      <data key="d1">HAS_GENRE</data>
      <data key="d2">욘 포세</data>
      <data key="d3">그의 작품이 주로 다루고 있는 것은 가족관계와 세대 간의 관계를 통해 볼 수 있는 인생, 사랑과 죽음 같은 우리의 삶에서 볼 수 있는 보편적인 모습들이다.</data>
    </edge>
    <edge source="욘 포세" target="산문" id="HAS_GENRE">
      <data key="d1">HAS_GENRE</data>
      <data key="d2">욘 포세</data>
      <data key="d3">2023년에 "말할 수 없는 것에 목소리를 부여하는 혁신적인 희곡과 산문"을 발표한 공로를 인정받아 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="월레 소잉카" target="나이지리아" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">월레 소잉카</data>
      <data key="d3">아킨완데 올루월레 "월레" 소잉카는 나이지리아의 소설가, 시인, 극작가이다.</data>
    </edge>
    <edge source="월레 소잉카" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">월레 소잉카</data>
      <data key="d3">1986년 〈해설자〉라는 소설로 아프리카 출신으로서는 처음으로 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="월레 소잉카" target="영어" id="WROTE_IN">
      <data key="d1">WROTE_IN</data>
      <data key="d2">월레 소잉카</data>
      <data key="d3">영어로 글을 쓰면서, 요루바 족의 종교, 철학, 언어를 소개시켰다.</data>
    </edge>
    <edge source="월레 소잉카" target="사람이 죽다:소잉카의 교도소 기록" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">월레 소잉카</data>
      <data key="d3">그 경험을 회고록 《사람이 죽다: 소잉카의 교도소 기록》에 담았다.</data>
    </edge>
    <edge source="월레 소잉카" target="콩기의 추수" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">월레 소잉카</data>
      <data key="d3">유럽의 식민지주의를 보여주는 〈콩기의 추수〉(1965년)와 〈거인들의 연극〉(1984년) 등의 연극을 만들기도 했다.</data>
    </edge>
    <edge source="월레 소잉카" target="거인들의 연극" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">월레 소잉카</data>
      <data key="d3">유럽의 식민지주의를 보여주는 〈콩기의 추수〉(1965년)와 〈거인들의 연극〉(1984년) 등의 연극을 만들기도 했다.</data>
    </edge>
    <edge source="윈스턴 처칠" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">윈스턴 처칠</data>
      <data key="d3">처칠은 두 임기 사이에 여러 권의 책을 썼고, 1953년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="영국" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">윌리엄 골딩</data>
      <data key="d3">윌리엄 골딩 경(Sir William Gerald Golding, CBE, 1911년 9월 19일 ~ 1993년 6월 19일)은 영국의 소설가, 극작가이자 시인이다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">윌리엄 골딩</data>
      <data key="d3">1983년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="부커상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">윌리엄 골딩</data>
      <data key="d3">1980년에는 바다 3부작 《땅 끝까지》의 첫 소설인 《성인 의식》으로 부커상을 받았고, 1983년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="왕립문학회" id="BELONGS_TO">
      <data key="d1">BELONGS_TO</data>
      <data key="d2">윌리엄 골딩</data>
      <data key="d3">문학에 기여한 공로로 1988년 기사 작위를 받았으며, 왕립문학회 회원이기도 했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="파리대왕" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">윌리엄 골딩</data>
      <data key="d3">그의 데뷔 소설 《파리대왕》(1954)은 가장 잘 알려진 작품이며, 평생 소설 12권을 더 출판했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="통과 의례" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">윌리엄 골딩</data>
      <data key="d3">그는 평생 12권의 소설을 발표했고, 《통과 의례》로 시작하는 해양 3부작 《지구 끝까지》로 1980년 부커상을 받았다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">윌리엄 포크너</data>
      <data key="d3">그는 1949년 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="미국" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">윌리엄 포크너</data>
      <data key="d3">그는 미국의 작가이다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="The Sound and the Fury" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">윌리엄 포크너</data>
      <data key="d3">대표작으로는 The Sound and the Fury 음향과 분노 (1929) 등이 있다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="As I Lay Dying" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">윌리엄 포크너</data>
      <data key="d3">대표작으로는 As I Lay Dying 내가 죽어 누워 있을 때 (1930) 등이 있다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="Light in August" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">윌리엄 포크너</data>
      <data key="d3">대표작으로는 Light in August 8월의 빛 (1932) 등이 있다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="Absalom, Absalom!" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">윌리엄 포크너</data>
      <data key="d3">대표작으로는 Absalom, Absalom! 압살롬, 압살롬 (1936) 등이 있다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="영어" id="WROTE_IN">
      <data key="d1">WROTE_IN</data>
      <data key="d2">윌리엄 포크너</data>
      <data key="d3">그의 명성은 장편 소설과 단편 소설에 바탕을 둔 것이지만 포크너는 시집도 냈고, 때때로 시나리오도 썼다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="프랑스" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">장마리 귀스타브 르 클레지오</data>
      <data key="d3">그는 1940년 니스의 리비에라에서 영국계 아버지와 프랑스인 어머니 사이에서 태어났다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">장마리 귀스타브 르 클레지오</data>
      <data key="d3">그는 1963년 르노도 상과 2008년 노벨 문학상을 수상하였다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="프랑스어" id="WROTE_IN">
      <data key="d1">WROTE_IN</data>
      <data key="d2">장마리 귀스타브 르 클레지오</data>
      <data key="d3">국적으로는 2000년 가오싱젠 이후, 언어로는 1985년 클로드 시몽 이후 첫 번째 프랑스 국적과 프랑스어 작가로서 노벨 문학상을 수상하게 되었다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="포스트모더니즘" id="BELONGS_TO">
      <data key="d1">BELONGS_TO</data>
      <data key="d2">장마리 귀스타브 르 클레지오</data>
      <data key="d3">그는 포스트모더니즘 작가이다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="조서" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">장마리 귀스타브 르 클레지오</data>
      <data key="d3">그의 첫 번째 소설인 《조서(Le Procès-Verbal)》는 공쿠르 상에 후보로 올랐으며, 이 작품으로 1963년에 르노도 상을 수상하며 화려하게 데뷔했다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="열병" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">장마리 귀스타브 르 클레지오</data>
      <data key="d3">주요작품으로는 &lt;열병&gt;(1965), &lt;홍수&gt;(1970), &lt;전쟁&gt;(1970), &lt;저편으로의 여행&gt;(1975), &lt;지상의 마지막 인간&gt;(1978) 등이 있다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="홍수" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">장마리 귀스타브 르 클레지오</data>
      <data key="d3">주요작품으로는 &lt;열병&gt;(1965), &lt;홍수&gt;(1970), &lt;전쟁&gt;(1970), &lt;저편으로의 여행&gt;(1975), &lt;지상의 마지막 인간&gt;(1978) 등이 있다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="전쟁" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">장마리 귀스타브 르 클레지오</data>
      <data key="d3">주요작품으로는 &lt;열병&gt;(1965), &lt;홍수&gt;(1970), &lt;전쟁&gt;(1970), &lt;저편으로의 여행&gt;(1975), &lt;지상의 마지막 인간&gt;(1978) 등이 있다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="저편으로의 여행" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">장마리 귀스타브 르 클레지오</data>
      <data key="d3">주요작품으로는 &lt;열병&gt;(1965), &lt;홍수&gt;(1970), &lt;전쟁&gt;(1970), &lt;저편으로의 여행&gt;(1975), &lt;지상의 마지막 인간&gt;(1978) 등이 있다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="지상의 마지막 인간" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">장마리 귀스타브 르 클레지오</data>
      <data key="d3">주요작품으로는 &lt;열병&gt;(1965), &lt;홍수&gt;(1970), &lt;전쟁&gt;(1970), &lt;저편으로의 여행&gt;(1975), &lt;지상의 마지막 인간&gt;(1978) 등이 있다.</data>
    </edge>
    <edge source="조수에 카르두치" target="이탈리아" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">조수에 카르두치</data>
      <data key="d3">이탈리아의 시인·고전문학자이다.</data>
    </edge>
    <edge source="조수에 카르두치" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">조수에 카르두치</data>
      <data key="d3">1906년에는 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="조수에 카르두치" target="낭만주의" id="BELONGS_TO">
      <data key="d1">BELONGS_TO</data>
      <data key="d2">조수에 카르두치</data>
      <data key="d3">그는 낭만주의에 맞선 문학 모임 ‘아미치 페단티’를 친구들과 결성했다.</data>
    </edge>
    <edge source="조수에 카르두치" target="민중의 하프" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">조수에 카르두치</data>
      <data key="d3">1855년 카르두치는 학교용 이탈리아 시 선집 《민중의 하프》를 출판했다.</data>
    </edge>
    <edge source="조수에 카르두치" target="유베닐리아" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">조수에 카르두치</data>
      <data key="d3">초기 시집 《유베닐리아》는 단테·페트라르카와 고전 시형식의 영향을 보여 주며.</data>
    </edge>
    <edge source="존 스타인벡" target="미국" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">존 스타인벡</data>
      <data key="d3">존 스타인벡은 독일계 미국인, 아일랜드계 미국인, 잉글랜드계 미국인, 미국의 노벨상 수상자, 미국의 반자본주의자, 미국의 사회주의자, 미국의 소설가, 미국의 여행 작가이다.</data>
    </edge>
    <edge source="존 스타인벡" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">존 스타인벡</data>
      <data key="d3">분류: 1902년 출생, 1968년 사망, 노벨 문학상 수상자</data>
    </edge>
    <edge source="존 스타인벡" target="분노의 포도" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">존 스타인벡</data>
      <data key="d3">스타인벡은 이 작품에 토지 소유주인 은행에 의해 농장을 빼앗긴 조드 일가를 등장시켜, 지주, 은행, 경찰의 노동자들에 대한 탄압을 고발하였다.</data>
    </edge>
    <edge source="존 스타인벡" target="의심스러운 싸움" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">존 스타인벡</data>
      <data key="d3">1936년 스타인벡은 미국 공산주의 운동을 소재로 한《의심스러운 싸움》을 발표하였다.</data>
    </edge>
    <edge source="존 스타인벡" target="생쥐와 인간" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">존 스타인벡</data>
      <data key="d3">1929년 해적 소설 《황금의 잔》으로 문단에 등장하였고 &lt;생쥐와 인간&gt;으로 유명해졌다.</data>
    </edge>
    <edge source="존 스타인벡" target="달은 지다" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">존 스타인벡</data>
      <data key="d3">그외 작품으로는 《불만의 겨울》과 《달은 지다》《에덴의 동쪽》등이 있다.</data>
    </edge>
    <edge source="존 스타인벡" target="에덴의 동쪽" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">존 스타인벡</data>
      <data key="d3">그외 작품으로는 《불만의 겨울》과 《달은 지다》《에덴의 동쪽》등이 있다.</data>
    </edge>
    <edge source="존 스타인벡" target="영어" id="WROTE_IN">
      <data key="d1">WROTE_IN</data>
      <data key="d2">존 스타인벡</data>
      <data key="d3">그의 작품은 따뜻한 인간미가 넘치는 문체에 특징이 있다.</data>
    </edge>
    <edge source="카를 아돌프 기엘레루프" target="덴마크" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">카를 아돌프 기엘레루프</data>
      <data key="d3">카를 아돌프 기엘레루프(덴마크어: Karl Adolph Gjellerup, 1857년 6월 2일 ~ 1919년 10월 11일)는 덴마크의 시인이자 소설가로, 스칸디나비아 문학의 ‘현대적 돌파’ 시기에 활동했다.</data>
    </edge>
    <edge source="카를 아돌프 기엘레루프" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">카를 아돌프 기엘레루프</data>
      <data key="d3">1917년에 동포인 헨리크 폰토피단과 함께 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="카를 아돌프 기엘레루프" target="덴마크어" id="WROTE_IN">
      <data key="d1">WROTE_IN</data>
      <data key="d2">카를 아돌프 기엘레루프</data>
      <data key="d3">그는 1900년 무렵부터 덴마크어 대신 독일어로만 작품을 쓰기 시작했으며, 독일어가 예술가로서의 발전에 도움이 된다고 생각했다.</data>
    </edge>
    <edge source="카를 아돌프 기엘레루프" target="Germanernes Lærling" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">카를 아돌프 기엘레루프</data>
      <data key="d3">초기 대표작으로는 자전적 성격의 소설 《Germanernes Lærling》(1882년)</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="스페인" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">카밀로 호세 셀라</data>
      <data key="d3">제1대 이리아플라비아 후작 카밀로 호세 셀라 이 트룰로크(Camilo José Cela y Trulock, 1st Marquis of Iria Flavia, 1916년 5월 11일 ~ 2002년 1월 17일)은 스페인의 소설가이자 1989년 노벨 문학상 수상자이다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">카밀로 호세 셀라</data>
      <data key="d3">그는 1989년 스페인에서는 다섯 번째로, 소설가로는 처음으로 노벨 문학상을 수상하게 된다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="빠스꾸알 두아르떼의 가족" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">카밀로 호세 셀라</data>
      <data key="d3">1942년 『빠스꾸알 두아르떼의 가족』은 전후의 소설사에 있어서 첫 번째 큰 사건이었다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="벌집" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">카밀로 호세 셀라</data>
      <data key="d3">1951년에 출간된 『벌집』은 대단원의 결말도 없는 작품이다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="알까리아로의 여행" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">카밀로 호세 셀라</data>
      <data key="d3">그리고 1946년 6월 6일에서 15일까지 알까리아로 여행을 하는데 이 곳에 그가 겪은 이야기들은 1948년 출판한 《알까리아로의여행 Viaje a la Alcarria》에 그 내용이 담겨있다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="콜드웰 부인이 아들과 나누는 대화" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">카밀로 호세 셀라</data>
      <data key="d3">죽은 아들 때문에 미쳐버린 여인이 아들에게 보내는 상상속의 편지들의 내용을 담은 이 소설은 내부 독백을 통한 잠재의식의 표출했다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="라 까띠라" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">카밀로 호세 셀라</data>
      <data key="d3">이 작품은 카밀로 호세 셀라가 스페인 비평문학상을 받은 작품으로 중남미 스페인어로 씌어진 리얼리즘 계열의 작품이다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="1936년, 산 까밀로" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">카밀로 호세 셀라</data>
      <data key="d3">스페인 내전이전의 사회적 분위기를 기술한 작품이다.</data>
    </edge>
    <edge source="카밀로 호세 셀라" target="두 명의 사자를 위한 마수르카" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">카밀로 호세 셀라</data>
      <data key="d3">살인과 복수극을 초현실주의 기법으로 찬란한 이미지속에 전개한 전율주의의 블랙유머적 품위와 함께 독자를 끝없이 매료하고 있다.</data>
    </edge>
    <edge source="케르테스 임레" target="헝가리" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">케르테스 임레</data>
      <data key="d3">그는 헝가리의 소설가이다.</data>
    </edge>
    <edge source="케르테스 임레" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">케르테스 임레</data>
      <data key="d3">그는 2002년에 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="케르테스 임레" target="헝가리어" id="WROTE_IN">
      <data key="d1">WROTE_IN</data>
      <data key="d2">케르테스 임레</data>
      <data key="d3">그는 1953년에 작가 겸 번역가로 활동하기 시작했다.</data>
    </edge>
    <edge source="케르테스 임레" target="운명" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">케르테스 임레</data>
      <data key="d3">1975년에 자신의 첫 소설인 《운명 (헝가리어: Sorstalanság)》을 발표했다.</data>
    </edge>
    <edge source="케르테스 임레" target="좌절" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">케르테스 임레</data>
      <data key="d3">그의 대표 작품으로 《좌절 (헝가리어: A kudarc)》 (1988년 작) 등이 있다.</data>
    </edge>
    <edge source="케르테스 임레" target="태어나지 않은 아이를 위한 기도" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">케르테스 임레</data>
      <data key="d3">그의 대표 작품으로 《태어나지 않은 아이를 위한 기도 (헝가리어: Kaddis a meg nem született gyermekért)》 (1990년 작) 등이 있다.</data>
    </edge>
    <edge source="케르테스 임레" target="청산" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">케르테스 임레</data>
      <data key="d3">그의 대표 작품으로 《청산 (헝가리어: Felszámolás)》 (2003년 작) 등이 있다.</data>
    </edge>
    <edge source="크누트 함순" target="노르웨이" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">크누트 함순</data>
      <data key="d3">노르웨이의 소설가이다.</data>
    </edge>
    <edge source="크누트 함순" target="노벨 문학상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">크누트 함순</data>
      <data key="d3">1920년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="크누트 함순" target="굶주림" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">크누트 함순</data>
      <data key="d3">1890년에 소설 《굶주림》을 발표했다.</data>
    </edge>
    <edge source="크누트 함순" target="여왕 타마라" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">크누트 함순</data>
      <data key="d3">이 때의 경험을 바탕으로 연극 《여왕 타마라》를 썼다.</data>
    </edge>
    <edge source="크누트 함순" target="신비" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">크누트 함순</data>
      <data key="d3">작품에 소설 《신비》, 《처녀지》와 희곡 《제국의 문턱에서》, 《투쟁 생활》 등이 있다.</data>
    </edge>
    <edge source="크누트 함순" target="풀이 무성한 길에서" id="AUTHORED">
      <data key="d1">AUTHORED</data>
      <data key="d2">크누트 함순</data>
      <data key="d3">1949년 마지막 작품인 《풀이 무성한 길에서》(노르웨이어: På gjengrodde stier)를 출간한 함순은 1952년 그림스타드에 있는 자택 뇌어홀름(노르웨이어: Nørholm)에서 사망했다.</data>
    </edge>
    <edge source="크러스너호르커이 라슬로" target="헝가리" id="NATIONALITY">
      <data key="d1">NATIONALITY</data>
      <data key="d2">크러스너호르커이 라슬로</data>
      <data key="d3">크러스너호르커이 라슬로(헝가리어: Krasznahorkai László, 1954년 1월 5일 ~ )는 헝가리의 소설가로, 포스트모더니즘과 디스토피아 정서를 주로 다룬다.</data>
    </edge>
    <edge source="크러스너호르커이 라슬로" target="국제 부커상" id="WON">
      <data key="d1">WON</data>
      <data key="d2">크러스너호르커이 라슬로</data>
      <data key="d3">2015년 국제 부커상 수상을 거쳐 2025년 노벨문학상을 수상하였다.</data>
    </edge>
