    <edge source="베르네르 폰 헤이덴스탐" target="스웨덴" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">스웨덴의 시인·소설가이다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">1916년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="스웨덴어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">스웨덴의 시인·소설가이다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="자연주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">당시의 자연주의 문학에 반항(反抗)한 그는 소설 &lt;한스 알리에누스&gt;로서 편력(遍歷) 끝에 안주(安住)의 땅을 고향에서 발견하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="하나의 민족" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">애국시집 &lt;하나의 민족&gt; 가운데의 1편인 &lt;스웨덴&gt;은 제2국가(國歌)로서 지금도 불리고 있다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="순례와 편력의 세월" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">1888년 첫 작품 &lt;순례와 편력의 세월&gt;에서 동방인의 방일(放逸)하고 소박한 생활의 환희를 노래하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="한스 알리에누스" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">소설 &lt;한스 알리에누스&gt;로서 편력(遍歷) 끝에 안주(安住)의 땅을 고향에서 발견하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="카를 왕의 군대" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">이 열정은 스웨덴과 러시아 제국 간의 대북방 전쟁에서 병사들의 충성을 그린 &lt;카를 왕의 군대&gt;(1898)에서 그 정점에 도달된다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="숲은 술렁인다" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">그는 다시 &lt;숲은 술렁인다&gt; &lt;성(聖) 게오르게와 용(龍)&gt;에서 조국에의 사랑과 희생적 정신을 높이 제창하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="성(聖) 게오르게와 용(龍)" id="AUTHORED">
      <data key="d2">AUTHORED</data>
