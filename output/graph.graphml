    </edge>
    <edge source="하신토 베나벤테" target="스페인" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">하신토 베나벤테</data>
      <data key="d4">20세기 스페인을 대표하는 극작가 중 한 명이다.</data>
    </edge>
    <edge source="하신토 베나벤테" target="모더니즘" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">하신토 베나벤테</data>
      <data key="d4">'모더니즘'과 '98년 사조'의 두 종류와 상관없이 전시대의 '생활 사생문학'을 연극을 통해 이어받은 극작가이다.</data>
    </edge>
    <edge source="하신토 베나벤테" target="스페인어" id="WROTE_IN">
