      <data key="d2">WROTE_IN</data>
      <data key="d3">밥 딜런</data>
      <data key="d4">밥 딜런은 미국의 싱어송라이터, 작가, 화가이다.</data>
    </edge>
    <edge source="밥 딜런" target="포크" id="HAS_GENRE">
      <data key="d2">HAS_GENRE</data>
      <data key="d3">밥 딜런</data>
      <data key="d4">그는 포크, 블루스, 컨트리에서 가스펠, 로큰롤과 로커빌리에서 영국, 스코틀랜드, 아일랜드 포크 음악까지를 포섭하면서 고전 미국 노래를 탐구했다.</data>
    </edge>
    <edge source="밥 딜런" target="반문화" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">밥 딜런</data>
      <data key="d4">그의 가사는 현존한 대중음악의 관습에 저항하며 급성장하는 반문화에 호소했다.</data>
    </edge>
    <edge source="밥 딜런" target="그래미상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">밥 딜런</data>
      <data key="d4">일곱 번의 그래미상, 골든 글로브상 한 번, 아카데미상 한 번을 받았다.</data>
    </edge>
    <edge source="밥 딜런" target="그래미 평생 공로상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">밥 딜런</data>
      <data key="d4">일곱 번의 그래미상, 골든 글로브상 한 번, 아카데미상 한 번을 받았다.</data>
    </edge>
    <edge source="밥 딜런" target="폴라음악상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">밥 딜런</data>
      <data key="d4">2000년에 스웨덴의 왕립음악원에서 주관하는 폴라음악상의 주인공이 되었다.</data>
    </edge>
    <edge source="밥 딜런" target="퓰리처상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">밥 딜런</data>
      <data key="d4">2008년 퓰리처상 심사위원들은 딜런에게 '그의 가사 작품의 비범한 시적 힘이 아로새긴 대중음악 및 미국 문화에서의 깊은 영향'을 인정해 특별 표창을 했다.</data>
    </edge>
    <edge source="밥 딜런" target="바람만이 아는 대답" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">밥 딜런</data>
      <data key="d4">2004년 출판된 회고록 《바람만이 아는 대답: 밥 딜런 자서전》은 뉴욕 타임스의 논픽션 부문 베스트셀러 목록에 19주간 머물렀다.</data>
    </edge>
    <edge source="밥 딜런" target="타란툴라" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">밥 딜런</data>
      <data key="d4">타란툴라 (1971): 소설</data>
    </edge>
    <edge source="버트런드 러셀" target="영국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">그는 웨일스에서 태어났고 그곳에서 사망했다.</data>
    </edge>
    <edge source="버트런드 러셀" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">1950년 노벨 문학상을 수상하였다.</data>
    </edge>
    <edge source="버트런드 러셀" target="수학 원리" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">화이트헤드와 함께 《수학 원리》를 저술하여 수리논리학의 성립에 공헌하였으며,</data>
    </edge>
    <edge source="버트런드 러셀" target="On Denoting" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">그의 철학 에세이 〈On Denoting〉은 "철학의 패러다임"으로 간주되고 있다.</data>
    </edge>
    <edge source="버트런드 러셀" target="결과주의자" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">버트런드 러셀</data>
      <data key="d4">그는 일생의 여러 부분에서 자유주의자, 사회주의자, 평화주의자 순으로 자신의 이상을 생각해왔으나,</data>
    </edge>
