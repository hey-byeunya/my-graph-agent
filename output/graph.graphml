    <edge source="베르네르 폰 헤이덴스탐" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">1916년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="스웨덴어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">스웨덴의 시인·소설가이다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="자연주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">당시의 자연주의 문학에 반항(反抗)한 그는 소설 &lt;한스 알리에누스&gt;로서 편력(遍歷) 끝에 안주(安住)의 땅을 고향에서 발견하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="순례와 편력의 세월" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">1888년 첫 작품 &lt;순례와 편력의 세월&gt;에서 동방인의 방일(放逸)하고 소박한 생활의 환희를 노래하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="한스 알리에누스" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">소설 &lt;한스 알리에누스&gt;로서 편력(遍歷) 끝에 안주(安住)의 땅을 고향에서 발견하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="카를 왕의 군대" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">이 열정은 스웨덴과 러시아 제국 간의 대북방 전쟁에서 병사들의 충성을 그린 &lt;카를 왕의 군대&gt;(1898)에서 그 정점에 도달된다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="숲은 술렁인다" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">그는 다시 &lt;숲은 술렁인다&gt; &lt;성(聖) 게오르게와 용(龍)&gt;에서 조국에의 사랑과 희생적 정신을 높이 제창하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="성(聖) 게오르게와 용(龍)" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">그는 다시 &lt;숲은 술렁인다&gt; &lt;성(聖) 게오르게와 용(龍)&gt;에서 조국에의 사랑과 희생적 정신을 높이 제창하고.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="성(聖) 비르기타의 순례" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">또한 조국의 중세사에서 제재(題材)를 따 &lt;성(聖) 비르기타의 순례&gt; &lt;폴쿤가가(家)의 이야기&gt; 등의 역사소설을 썼다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="폴쿤가가(家)의 이야기" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">또한 조국의 중세사에서 제재(題材)를 따 &lt;성(聖) 비르기타의 순례&gt; &lt;폴쿤가가(家)의 이야기&gt; 등의 역사소설을 썼다.</data>
    </edge>
    <edge source="베르네르 폰 헤이덴스탐" target="하나의 민족" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">베르네르 폰 헤이덴스탐</data>
      <data key="d4">애국시집 &lt;하나의 민족&gt; 가운데의 1편인 &lt;스웨덴&gt;은 제2국가(國歌)로서 지금도 불리고 있다.</data>
    </edge>
    <edge source="루돌프 크리스토프 오이켄" target="독일" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">루돌프 크리스토프 오이켄</data>
      <data key="d4">루돌프 크리스토프 오이켄은 독일의 철학자이다.</data>
    </edge>
    <edge source="루돌프 크리스토프 오이켄" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">루돌프 크리스토프 오이켄</data>
      <data key="d4">1908년에는 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="루돌프 크리스토프 오이켄" target="생의 철학" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">루돌프 크리스토프 오이켄</data>
      <data key="d4">오이켄의 학설은 '생의 철학'의 일종으로 볼 수 있으나, 자연적인 생명현상을 그대로 시인하는 것이 아니었으며...</data>
    </edge>
    <edge source="루돌프 크리스토프 오이켄" target="대사상가의 인생관" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">루돌프 크리스토프 오이켄</data>
      <data key="d4">서양의 철학과 종교 사상을 역사적으로 개관한 주저 &lt;대사상가의 인생관&gt;(1890) 이외에...</data>
    </edge>
    <edge source="루돌프 크리스토프 오이켄" target="정신생활의 통일성" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">루돌프 크리스토프 오이켄</data>
      <data key="d4">&lt;정신생활의 통일성&gt;(1888), &lt;정신생활 내용을 위한 투쟁&gt;(1896) &lt;종교의 진리 내용&gt;(1901) 등이 계속해서 그 시기에 간행되었고...</data>
    </edge>
    <edge source="싱클레어 루이스" target="미국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">싱클레어 루이스</data>
      <data key="d4">헤리 싱클레어 루이스(Harry Sinclair Lewis, 1885년 2월 7일 ~ 1951년 1월 10일)는 미국의 작가이다.</data>
    </edge>
    <edge source="싱클레어 루이스" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">싱클레어 루이스</data>
      <data key="d4">1930년 미국 문학 역사에서는 처음으로 노벨문학상을 받았다.</data>
    </edge>
    <edge source="어니스트 헤밍웨이" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">어니스트 헤밍웨이</data>
      <data key="d4">1954년에는 노벨 문학상을 수상하였다.</data>
    </edge>
    <edge source="어니스트 헤밍웨이" target="미국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">어니스트 헤밍웨이</data>
      <data key="d4">어니스트 밀러 헤밍웨이(영어: Ernest Miller Hemingway, 1899년 7월 21일~1961년 7월 2일)는 미국의 소설가이자 언론인이다.</data>
    </edge>
    <edge source="어니스트 헤밍웨이" target="영어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">어니스트 헤밍웨이</data>
      <data key="d4">어니스트 밀러 헤밍웨이(영어: Ernest Miller Hemingway, 1899년 7월 21일~1961년 7월 2일)는 미국의 소설가이자 언론인이다.</data>
    </edge>
    <edge source="어니스트 헤밍웨이" target="무기여 잘 있거라" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">어니스트 헤밍웨이</data>
      <data key="d4">이때 그가 겪은 전쟁 경험은 소설 《무기여 잘 있거라》의 기초를 형성하였다.</data>
    </edge>
    <edge source="어니스트 헤밍웨이" target="태양은 다시 떠오른다" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">어니스트 헤밍웨이</data>
      <data key="d4">1926년에는 첫 소설인 《태양은 다시 떠오른다》를 출판하였다.</data>
    </edge>
    <edge source="어니스트 헤밍웨이" target="누구를 위하여 종은 울리나" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">어니스트 헤밍웨이</data>
      <data key="d4">헤밍웨이는 내전을 바탕으로 1940년 《누구를 위하여 종은 울리나》(1940)를 썼다.</data>
    </edge>
    <edge source="어니스트 헤밍웨이" target="노인과 바다" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">어니스트 헤밍웨이</data>
      <data key="d4">1952년에 《노인과 바다》를 출판하고 난 이후 헤밍웨이는 아프리카의 사파리로 떠났다.</data>
    </edge>
    <edge source="어니스트 헤밍웨이" target="잃어버린 세대" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">어니스트 헤밍웨이</data>
      <data key="d4">헤밍웨이는 파리에서 소위 ‘잃어버린 세대’라고 불리는 1920년대 근대주의적 작가들과 미술가들에게서 영향을 받는다.</data>
    </edge>
    <edge source="헨리크 시엔키에비치" target="폴란드" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">헨리크 시엔키에비치</data>
      <data key="d4">헨리크 아담 알렉산데르 피우스 시엔키에비치(폴란드어: Henryk Adam Aleksander Pius Sienkiewicz, ... 19세기 폴란드 사람, 20세기 폴란드 사람, 노벨 문학상 수상자, ... 폴란드의 소설가, 헨리크 시엔키에비치</data>
    </edge>
    <edge source="헨리크 시엔키에비치" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">헨리크 시엔키에비치</data>
      <data key="d4">1905년 노벨 문학상을 수상하고 제1차 세계 대전 중 ...</data>
    </edge>
    <edge source="헨리크 시엔키에비치" target="폴란드어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">헨리크 시엔키에비치</data>
      <data key="d4">등대지기가 모국어인 폴란드어의 아름다움에 감동하는 이야기이다.</data>
    </edge>
    <edge source="헨리크 시엔키에비치" target="쿠오 바디스" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">헨리크 시엔키에비치</data>
      <data key="d4">기독교인들이 로마제국의 억압에도 강건함을 잃지 않는 이야기인 &lt;쿠오 바디스&gt;로 그의 소설가로서의 명성은 세계적인 것이 되었다.</data>
    </edge>
    <edge source="헨리크 시엔키에비치" target="19세기 폴란드 사람" id="BELONGS_TO">
