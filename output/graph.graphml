    <edge source="요르고스 세페리스" target="윌리엄 포일상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">요르고스 세페리스</data>
      <data key="d4">그는 현대 그리스 문학에 기여한 공로로 1960년 윌리엄 포일상을 받았다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="덴마크" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">요하네스 빌헬름 옌센</data>
      <data key="d4">덴마크의 소설가이다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">요하네스 빌헬름 옌센</data>
      <data key="d4">그 결과 구약성서, 스칸디나비아 신화, 아이슬란드의 사가 등을 이용하여 지질학·인류학·고고학·민족학의 지식을 바탕으로 서술하여 소년시절의 회상이나 그가 얻은 많은 여행에서의 인상도 집어넣고 있다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="긴 여행" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">요하네스 빌헬름 옌센</data>
      <data key="d4">후에 세계일주 여행길에 일본에 기착하여 1906년 신화 《후지산(富士山)》을 발표했으며 다양한 그의 작가활동 중에서 한 가지를 들어 본다면 노벨 문학상(1944)의 대상이 되었던 &lt;긴 여행(旅行)&gt;(1909-21)이다.</data>
    </edge>
    <edge source="요하네스 빌헬름 옌센" target="덴마크어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">요하네스 빌헬름 옌센</data>
      <data key="d4">덴마크의 소설가이다.</data>
    </edge>
    <edge source="욘 포세" target="노르웨이" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">욘 포세</data>
      <data key="d4">욘 올라브 포세(노르웨이어: Jon Olav Fosse, 1959년 9월 29일 ~ )는 노르웨이의 문학가이다.</data>
    </edge>
    <edge source="욘 포세" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">욘 포세</data>
      <data key="d4">2023년에 "말할 수 없는 것에 목소리를 부여하는 혁신적인 희곡과 산문"을 발표한 공로를 인정받아 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="욘 포세" target="희곡" id="HAS_GENRE">
      <data key="d2">HAS_GENRE</data>
      <data key="d3">욘 포세</data>
      <data key="d4">그의 작품이 주로 다루고 있는 것은 가족관계와 세대 간의 관계를 통해 볼 수 있는 인생, 사랑과 죽음 같은 우리의 삶에서 볼 수 있는 보편적인 모습들이다.</data>
    </edge>
    <edge source="욘 포세" target="산문" id="HAS_GENRE">
      <data key="d2">HAS_GENRE</data>
      <data key="d3">욘 포세</data>
      <data key="d4">2023년에 "말할 수 없는 것에 목소리를 부여하는 혁신적인 희곡과 산문"을 발표한 공로를 인정받아 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="월레 소잉카" target="나이지리아" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">월레 소잉카</data>
      <data key="d4">아킨완데 올루월레 "월레" 소잉카는 나이지리아의 소설가, 시인, 극작가이다.</data>
    </edge>
    <edge source="월레 소잉카" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">월레 소잉카</data>
      <data key="d4">1986년 〈해설자〉라는 소설로 아프리카 출신으로서는 처음으로 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="월레 소잉카" target="영어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">월레 소잉카</data>
      <data key="d4">영어로 글을 쓰면서, 요루바 족의 종교, 철학, 언어를 소개시켰다.</data>
    </edge>
    <edge source="월레 소잉카" target="사람이 죽다:소잉카의 교도소 기록" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">월레 소잉카</data>
      <data key="d4">그 경험을 회고록 《사람이 죽다: 소잉카의 교도소 기록》에 담았다.</data>
    </edge>
    <edge source="월레 소잉카" target="콩기의 추수" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">월레 소잉카</data>
      <data key="d4">유럽의 식민지주의를 보여주는 〈콩기의 추수〉(1965년)와 〈거인들의 연극〉(1984년) 등의 연극을 만들기도 했다.</data>
    </edge>
    <edge source="월레 소잉카" target="거인들의 연극" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">월레 소잉카</data>
      <data key="d4">유럽의 식민지주의를 보여주는 〈콩기의 추수〉(1965년)와 〈거인들의 연극〉(1984년) 등의 연극을 만들기도 했다.</data>
    </edge>
    <edge source="윈스턴 처칠" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">윈스턴 처칠</data>
      <data key="d4">처칠은 두 임기 사이에 여러 권의 책을 썼고, 1953년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="영국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">윌리엄 골딩 경(Sir William Gerald Golding, CBE, 1911년 9월 19일 ~ 1993년 6월 19일)은 영국의 소설가, 극작가이자 시인이다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">1983년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="부커상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">1980년에는 바다 3부작 《땅 끝까지》의 첫 소설인 《성인 의식》으로 부커상을 받았고, 1983년 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="왕립문학회" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">문학에 기여한 공로로 1988년 기사 작위를 받았으며, 왕립문학회 회원이기도 했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="파리대왕" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">그의 데뷔 소설 《파리대왕》(1954)은 가장 잘 알려진 작품이며, 평생 소설 12권을 더 출판했다.</data>
    </edge>
    <edge source="윌리엄 골딩" target="통과 의례" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">윌리엄 골딩</data>
      <data key="d4">그는 평생 12권의 소설을 발표했고, 《통과 의례》로 시작하는 해양 3부작 《지구 끝까지》로 1980년 부커상을 받았다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">윌리엄 포크너</data>
      <data key="d4">그는 1949년 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="미국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">윌리엄 포크너</data>
      <data key="d4">그는 미국의 작가이다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="The Sound and the Fury" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">윌리엄 포크너</data>
      <data key="d4">대표작으로는 The Sound and the Fury 음향과 분노 (1929) 등이 있다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="As I Lay Dying" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">윌리엄 포크너</data>
      <data key="d4">대표작으로는 As I Lay Dying 내가 죽어 누워 있을 때 (1930) 등이 있다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="Light in August" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">윌리엄 포크너</data>
      <data key="d4">대표작으로는 Light in August 8월의 빛 (1932) 등이 있다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="Absalom, Absalom!" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">윌리엄 포크너</data>
      <data key="d4">대표작으로는 Absalom, Absalom! 압살롬, 압살롬 (1936) 등이 있다.</data>
    </edge>
    <edge source="윌리엄 포크너" target="영어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">윌리엄 포크너</data>
      <data key="d4">그의 명성은 장편 소설과 단편 소설에 바탕을 둔 것이지만 포크너는 시집도 냈고, 때때로 시나리오도 썼다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="프랑스" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">그는 1940년 니스의 리비에라에서 영국계 아버지와 프랑스인 어머니 사이에서 태어났다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">그는 1963년 르노도 상과 2008년 노벨 문학상을 수상하였다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="프랑스어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">국적으로는 2000년 가오싱젠 이후, 언어로는 1985년 클로드 시몽 이후 첫 번째 프랑스 국적과 프랑스어 작가로서 노벨 문학상을 수상하게 되었다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="포스트모더니즘" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">그는 포스트모더니즘 작가이다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="조서" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">그의 첫 번째 소설인 《조서(Le Procès-Verbal)》는 공쿠르 상에 후보로 올랐으며, 이 작품으로 1963년에 르노도 상을 수상하며 화려하게 데뷔했다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="열병" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">주요작품으로는 &lt;열병&gt;(1965), &lt;홍수&gt;(1970), &lt;전쟁&gt;(1970), &lt;저편으로의 여행&gt;(1975), &lt;지상의 마지막 인간&gt;(1978) 등이 있다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="홍수" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">주요작품으로는 &lt;열병&gt;(1965), &lt;홍수&gt;(1970), &lt;전쟁&gt;(1970), &lt;저편으로의 여행&gt;(1975), &lt;지상의 마지막 인간&gt;(1978) 등이 있다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="전쟁" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">주요작품으로는 &lt;열병&gt;(1965), &lt;홍수&gt;(1970), &lt;전쟁&gt;(1970), &lt;저편으로의 여행&gt;(1975), &lt;지상의 마지막 인간&gt;(1978) 등이 있다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="저편으로의 여행" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">주요작품으로는 &lt;열병&gt;(1965), &lt;홍수&gt;(1970), &lt;전쟁&gt;(1970), &lt;저편으로의 여행&gt;(1975), &lt;지상의 마지막 인간&gt;(1978) 등이 있다.</data>
    </edge>
    <edge source="장마리 귀스타브 르 클레지오" target="지상의 마지막 인간" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">장마리 귀스타브 르 클레지오</data>
      <data key="d4">주요작품으로는 &lt;열병&gt;(1965), &lt;홍수&gt;(1970), &lt;전쟁&gt;(1970), &lt;저편으로의 여행&gt;(1975), &lt;지상의 마지막 인간&gt;(1978) 등이 있다.</data>
    </edge>
    <edge source="장폴 사르트르" target="프랑스" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">장폴 사르트르</data>
      <data key="d4">무신론적 실존주의 사상을 대표하는 프랑스의 작가이자 철학자이다.</data>
    </edge>
    <edge source="장폴 사르트르" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">장폴 사르트르</data>
      <data key="d4">그해 노벨 문학상 수상자로 선정되었으나 수상을 거절한 것으로 유명하다.</data>
    </edge>
    <edge source="장폴 사르트르" target="존재와 무" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">장폴 사르트르</data>
      <data key="d4">사르트르의 작품은 &lt;존재와 무L'Être et le Néant&gt; (1943)...</data>
    </edge>
    <edge source="장폴 사르트르" target="실존주의는 휴머니즘이다" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">장폴 사르트르</data>
      <data key="d4">사르트르의 주요 철학서로는 &lt;존재와 무&gt; (1943)와 &lt;변증법적 이성 비판&gt; (1960)이 있다.</data>
    </edge>
    <edge source="장폴 사르트르" target="변증법적 이성 비판" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">장폴 사르트르</data>
      <data key="d4">사르트르의 주요 철학서로는 &lt;존재와 무&gt; (1943)와 &lt;변증법적 이성 비판&gt; (1960)이 있다.</data>
    </edge>
    <edge source="장폴 사르트르" target="실존주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">장폴 사르트르</data>
      <data key="d4">사르트르는 프랑스 실존주의의 아버지로 여겨지며 1945년 그의 강연 &lt;실존주의는 휴머니즘이다&gt;는 실존주의 철학 사상의 선언문으로 여겨진다.</data>
    </edge>
    <edge source="조수에 카르두치" target="이탈리아" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">조수에 카르두치</data>
      <data key="d4">이탈리아의 시인·고전문학자이다.</data>
    </edge>
    <edge source="조수에 카르두치" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">조수에 카르두치</data>
      <data key="d4">1906년에는 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="조수에 카르두치" target="낭만주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">조수에 카르두치</data>
      <data key="d4">그는 낭만주의에 맞선 문학 모임 ‘아미치 페단티’를 친구들과 결성했다.</data>
    </edge>
    <edge source="조수에 카르두치" target="민중의 하프" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">조수에 카르두치</data>
      <data key="d4">1855년 카르두치는 학교용 이탈리아 시 선집 《민중의 하프》를 출판했다.</data>
    </edge>
    <edge source="조수에 카르두치" target="유베닐리아" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">조수에 카르두치</data>
      <data key="d4">초기 시집 《유베닐리아》는 단테·페트라르카와 고전 시형식의 영향을 보여 주며.</data>
    </edge>
    <edge source="조지 버나드 쇼" target="아일랜드" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">조지 버나드 쇼</data>
      <data key="d4">조지 버너드 쇼(영어: George Bernard Shaw, 1856년 7월 26일~1950년 11월 2일)는 주로 버너드 쇼라는 필명으로 활동한 아일랜드 출신의 소설가, 극작가, 평론가, 연설가, 사회주의자, 사회활동가이다.</data>
    </edge>
    <edge source="조지 버나드 쇼" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">조지 버나드 쇼</data>
      <data key="d4">쇼는 《성 죤》을 발표한 후 1925년에 노벨문학상을 수상했고, 1938년에는 《피그말리온》의 영화 각본으로 아카데미상을 수상했다.</data>
    </edge>
    <edge source="조지 버나드 쇼" target="페이비언 협회" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">조지 버나드 쇼</data>
      <data key="d4">1880년대 중반 무렵에 정치적 각성을 계기로 점진주의적 사회주의 단체인 페이비언 협회에 가입한 후 저명한 연설문 작가가 되었다.</data>
    </edge>
    <edge source="조지 버나드 쇼" target="워런부인의 직업" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">조지 버나드 쇼</data>
      <data key="d4">그는 5편의 소설과 60여 편의 희곡을 집필했으며, 대표작으로 《워런부인의 직업》(1893) 등이 있다.</data>
    </edge>
    <edge source="조지 버나드 쇼" target="인간과 초인" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">조지 버나드 쇼</data>
