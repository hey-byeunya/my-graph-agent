    <edge source="오에 겐자부로" target="일본" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">오에 겐자부로(일본어: 大江健三郎, 1935년 1월 31일 ~ 2023년 3월 3일)는 일본의 작가로, 제2차 세계대전 패전 이후의 일본 전후세대를 대표한다.</data>
    </edge>
    <edge source="오에 겐자부로" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">그는 1994년 12월 8일 가와바타 야스나리(1968년 수상) 이후 26년 만에 노벨 문학상을 수상했다.</data>
    </edge>
    <edge source="오에 겐자부로" target="사육" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">도쿄 대학 불문과 재학 당시 사르트르 소설에 심취했으며 &lt;사육(飼育)&gt;이란 작품으로 아쿠타가와 상을 수상했다.</data>
    </edge>
    <edge source="오에 겐자부로" target="아이 싹 훑기" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">데뷔한 다음 해인 1958년, 자신의 첫 장편소설 &lt;아이 싹 훑기(芽むしり仔撃ち)&gt;를 발표했다.</data>
    </edge>
    <edge source="오에 겐자부로" target="우리들의 시대" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">같은 해에 새로운 장편 《우리들의 시대(われらの時代)》를 발표하였다.</data>
    </edge>
    <edge source="오에 겐자부로" target="개인적 체험" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">1964년, 히카리의 탄생을 기점으로 쓴 자전적 소설 《개인적 체험(個人的な体験)》으로 제 11회 신초샤 문학상을 수상하였다.</data>
    </edge>
    <edge source="오에 겐자부로" target="히로시마 노트" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">같은 해에 히로시마를 수차례 방문했던 경험과 세계원수폭금지대회에 참가한 경험을 토대로 한 르포르타주 《히로시마 노트》를 연재하기 시작했다.</data>
    </edge>
    <edge source="오에 겐자부로" target="타오르는 푸른 나무" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">1993년 9월부터 《신조》에 있어서 가장 긴 장편소설 3부작 《타오르는 푸른 나무》를 연재하기 시작했다.</data>
    </edge>
    <edge source="오에 겐자부로" target="공중회전" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">1996년 다케미쯔 토오루의 영결식에서 그를 위해 신작을 바치겠다고 약속하고 1999년 《공중회전》에서 집필을 다시 시작했다.</data>
    </edge>
    <edge source="오에 겐자부로" target="일본어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">오에 겐자부로(일본어: 大江健三郎, 1935년 1월 31일 ~ 2023년 3월 3일)는 일본의 작가로, 제2차 세계대전 패전 이후의 일본 전후세대를 대표한다.</data>
    </edge>
    <edge source="오에 겐자부로" target="전후파" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">초기에는 전후파 작가답게 전쟁 체험과 그 후유증을 소재로 인간의 내면세계를 응시하는 사회비판적인 작품을 많이 썼다.</data>
    </edge>
    <edge source="오에 겐자부로" target="가와바타 야스나리" id="INFLUENCED_BY">
      <data key="d2">INFLUENCED_BY</data>
      <data key="d3">오에 겐자부로</data>
      <data key="d4">수상기념 연설문, 《애매한 일본의 나》를 통해 그는 스웨덴의 아동문학작품 《닐스의 모험》을 읽으며 꿈꿨던 어린 시절 1968년 노벨 문학상 수상자인 가와바타 야스나리의 일본적인 신비주의에 대한 회의, 전자공학이나 자동차 생산 기술로 유명한 조국 일본에 대한 비판적인 시각을 말하였다.</data>
    </edge>
    <edge source="옥타비오 파스" target="멕시코" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">옥타비오 파스</data>
      <data key="d4">옥타비오 파스 로사노(Octavio Paz Lozano, 1914년 3월 31일 ~ 1998년 4월 19일)는 멕시코의 시인, 작가, 비평가 겸 외교관이다.</data>
    </edge>
    <edge source="옥타비오 파스" target="노벨 문학상" id="WON">
