    <edge source="T. S. 엘리엇" target="미국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">T. S. 엘리엇</data>
      <data key="d4">미국계 영국 시인, 극작가 그리고 문학 비평가였다.</data>
    </edge>
    <edge source="T. S. 엘리엇" target="영국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">T. S. 엘리엇</data>
      <data key="d4">후에 영국에 귀화했다.</data>
    </edge>
    <edge source="T. S. 엘리엇" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">T. S. 엘리엇</data>
      <data key="d4">1948년 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="T. S. 엘리엇" target="황무지" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">T. S. 엘리엇</data>
      <data key="d4">1922년 시 〈황무지〉를 발표하여 젊은 시인들에게 많은 영향을 끼쳤다.</data>
    </edge>
    <edge source="T. S. 엘리엇" target="사원의 살인" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">T. S. 엘리엇</data>
      <data key="d4">1935년 발표된 《사원의 살인》(Murder in the Cathedral)은 순교자 토머스 베켓을 주인공으로 한다.</data>
    </edge>
    <edge source="T. S. 엘리엇" target="알프레드 프루프록의 연가" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">T. S. 엘리엇</data>
      <data key="d4">그가 쓴 《J. 알프레드 프루프록의 연가》(The Love Song of J. Alfred Prufrock)</data>
    </edge>
    <edge source="V. S. 나이폴" target="트리니다드 토바고" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그는 트리니다드 토바고에서 태어난 인도계 영국인 작가이다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="부커상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그는 1971년에 맨부커상을, 2001년에 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">V. S. 나이폴|가와바타 야스나리|게르하르트 하웁트만|귄터 그라스|아니 에르노|이보 안드리치</data>
      <data key="d4">그는 1971년에 맨부커상을, 2001년에 노벨 문학상을 받았다. ⏐ 1968년(쇼와 43년)에 일본인 최초로 노벨 문학상을 수상했다. ⏐ 1912년에 노벨 문학상을 수상하였다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="신비로운 안마사" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《신비로운 안마사 (The Mystic Masseur)》(1957년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="비스와스씨의 집" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《비스와스씨의 집 (A House for Mr. Biswas)》(1961년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="중간의 길" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《중간의 길 (The Middle Passage: Impressions of Five Societies – British, French and Dutch in the West Indies and South America)》(1962년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="자유 국가에서" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《자유 국가에서 (In a Free State)》(1971년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="게릴라" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《게릴라 (Guerrillas)》(1975년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="인도: 상처 받은 문명" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《인도: 상처 받은 문명 (India: A Wounded Civilization)》(1977년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="강의 만곡" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《강의 만곡 (A Bend in the River)》(1979년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="믿음을 넘어서" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《믿음을 넘어서 (Among the Believers: An Islamic Journey)》(1981년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="도착의 수수께끼" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《도착의 수수께끼 (The Enigma of Arrival)》(1987년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="인도: 백만의 반란" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《인도: 백만의 반란 (India: A Million Mutinies Now)》(1990년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="일본" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">가와바타 야스나리(일본어: 川端 康成 (かわばた やすなり), 1899년 6월 14일~1972년 4월 16일)는 일본의 소설가이자 1968년의 노벨 문학상 수상자로, 오사카부 오사카시 기타구의 차화정(此花町, 지금의 덴진바시 부근)에서 태어났다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="신감각파" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">요코미쓰 리이치 등과 함께 『분게이지다이(文藝時代)』를 창간하여 당시 유럽의 허무주의, 미래파, 표현주의 영향을 받아서 생긴 문학 유파였던 신감각파(新感覺派)의 대표적 작가로서 활약하였다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="이즈의 무희" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">초기에는 왕조문학이나 불교 경전의 영향을 받아 허무한 슬픔과 서정성이 넘치는 작품을 많이 썼다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="설국" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">이후 비현실적인 미의 세계를 구축하는 방향으로 전환해 「설국」을 발표하기에 이르렀다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="천 마리의 종이학" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">1948년에는 일본펜클럽 제4대 회장으로 취임하였다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="산소리" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">그 뒤 「천 마리의 종이학」, 「산소리」 등을 단속적으로 발표하면서, 패전 뒤인 1948년에는 일본펜클럽 제4대 회장으로 취임하였다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="잠든 미녀" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">1962년 - 「잠든 미녀」로 제16회 마이니치 출판 문화상(毎日出版文化賞) 수상</data>
    </edge>
    <edge source="V. S. 나이폴" target="독일" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">게르하르트 하웁트만|귄터 그라스</data>
      <data key="d4">그는 독일의 희곡 작가이다. ⏐ 귄터 그라스(독일어: Günter Grass, 1927년 10월 16일 ~ 2015년 4월 13일)는 독일의 소설가이자 극작가다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="자연주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">그는 독일 자연주의 연극의 형성과 발전에 기여했다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="해가 뜨기 전" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">하웁트만의 첫 번째 희곡은 《해가 뜨기 전》(Vor Sonnenaufgang) (1889)으로, '자유무대'에서 초연되어 현대 독일 문학에서 자연주의 운동의 막을 연 작품이다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="직조공들" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">하웁트만의 최고걸작이라고 불리며 또한 가장 성공한 작품은 그 다음에 쓰여진 《직조공들》(Die Weber, The Weavers, 1892)이다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="하넬레의 승천" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">그것이 표면화된 것이 《하넬레의 승천(昇天)》(Hanneles Himmelfahrt, 1893)이며 1896년의 《침종(沈鍾)》에 이르러 절정이 된다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="침종" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">《침종》은 《직조공들》과 어깨를 나란히 하는 성공작이나, 가장 일찍이 그 평가를 잃은 작품이기도 했다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="아트리덴 사부극" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">그의 마지막 작품은 《아트리덴 사부극》Atriden-Tetralogie (1942–46)이었다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="독일어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">게르하르트 하웁트만</data>
      <data key="d4">하웁트만은 실레지아 지방의 작은 도시인 오버잘쯔브룬(Obersalzbrunn)에서 호텔 경영자의 아들로 태어났다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="양철북" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">귄터 그라스</data>
      <data key="d4">1959년에 매우 묘사적인 언어로 나중에 영화화 되기까지 한 《양철북》을 발표했다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="고양이와 쥐" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">귄터 그라스</data>
      <data key="d4">이어 &lt;고양이와 쥐&gt; &lt;개의 해&gt;에서도 전쟁 전과 전쟁 후에 걸친 시대의 과오와 대결하고 있으며, 무대는 다같이 단치히이다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="개의 시절" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">귄터 그라스</data>
      <data key="d4">이어 &lt;고양이와 쥐&gt; &lt;개의 해&gt;에서도 전쟁 전과 전쟁 후에 걸친 시대의 과오와 대결하고 있으며, 무대는 다같이 단치히이다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="넙치" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">귄터 그라스</data>
      <data key="d4">이밖의 작품에 &lt;달팽이의 일기에서&gt; &lt;넙치&gt; 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="암쥐" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">귄터 그라스</data>
      <data key="d4">《암쥐》(Die Rättin, 1986년)</data>
    </edge>
    <edge source="V. S. 나이폴" target="프랑스" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">아니 에르노</data>
      <data key="d4">아니 테레즈 블랑슈 에르노(프랑스어: Annie Thérèse Blanche Ernaux, 혼전 성씨: 뒤셴·Duchesne, 1940년 9월 1일 ~ )는 프랑스의 작가이자 문학 교수, 노벨문학상 수상자다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="르노도 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">아니 에르노</data>
      <data key="d4">1984년 《아버지의 자리》로 르노도 문학상을 수상했다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="유고슬라비아" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">이보 안드리치</data>
      <data key="d4">유고슬라비아의 노벨상 수상자, 유고슬라비아의 소설가</data>
    </edge>
    <edge source="V. S. 나이폴" target="드리나 강의 다리" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">이보 안드리치</data>
      <data key="d4">노벨 문학상을 받는 데 결정적 역할을 했던 소설 &lt;드리나 강의 다리&gt;는 보스니아와 세르비아의 접경에 위치한 작은 도시 비셰그라드와 이 도시를 가로질러 흐르고 있는 드리나 강 위에 놓인 다리를 중심으로 펼쳐지는 400여 년의 인간사를 다루고 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="세르보크로아트어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">이보 안드리치</data>
      <data key="d4">이보 안드리치(세르보크로아트어: Ivo Andrić, 1892년 10월 10일 ~ 1975년 3월 13일)은 보스니아의 문학가이다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="보스니아" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">이보 안드리치</data>
      <data key="d4">안드리치의 작품 대부분의 배경은 그가 태어난 보스니아다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="청년 보스니아 운동" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">이보 안드리치</data>
      <data key="d4">그는 혁명단체에 들어갔다. 이 단체의 조직원들은 남슬라브의 독립지원과 오스트리아-헝가리 제국으로부터 보스니아를 해방시키기 위해 투쟁했다.(‘청년 보스니아 운동’)</data>
    </edge>
    <edge source="가브리엘 가르시아 마르케스" target="콜롬비아" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">가브리엘 가르시아 마르케스</data>
      <data key="d4">가브리엘 호세 데 라 콘코르디아 가르시아 마르케스(스페인어: Gabriel José de la Concordia García Márquez, 1927년 3월 6일 ~ 2014년 4월 17일)는 콜롬비아의 소설가, 저널리스트이자 정치 운동가이다.</data>
    </edge>
    <edge source="가브리엘 가르시아 마르케스" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">가브리엘 가르시아 마르케스</data>
      <data key="d4">그의 대표작이기도 하며 또한 그를 콜롬비아의 미겔 데 세르반테스라고 일컫게 한 《백년 동안의 고독》은 마콘도(Ma­condo)라는 가공의 땅을 무대로 하여 부엔디아 일족의 역사를 그린 작품이며, 1982년 노벨 문학상 수상에 영향을 주었다.</data>
    </edge>
    <edge source="가브리엘 가르시아 마르케스" target="백년 동안의 고독" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘 가르시아 마르케스</data>
      <data key="d4">그의 대표작이기도 하며 또한 그를 콜롬비아의 미겔 데 세르반테스라고 일컫게 한 《백년 동안의 고독》은 마콘도(Ma­condo)라는 가공의 땅을 무대로 하여 부엔디아 일족의 역사를 그린 작품이며, 1982년 노벨 문학상 수상에 영향을 주었다.</data>
    </edge>
    <edge source="가브리엘 가르시아 마르케스" target="예고된 죽음의 연대기" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘 가르시아 마르케스</data>
      <data key="d4">1981년에는 《예고된 죽음의 연대기》가 라틴아메리카에서만 200만 부 이상 팔렸으며, 1982년 라틴아메리카 현대 소설의 대표적인 작품으로 평가되었다.</data>
    </edge>
    <edge source="가브리엘 가르시아 마르케스" target="더러운 시간" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘 가르시아 마르케스</data>
      <data key="d4">=== 장편 === 《더러운 시간》(1962)</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="칠레" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">칠레의 시인·외교관·언론인·교육자인 루실라 고도이 알카야가의 필명이다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">라틴아메리카 출신 작가로는 처음으로 1945년 노벨 문학상을 수상했으며</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="스페인어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">스페인어권 전역에 유통된 800편가량의 글을 비롯해 지리·교육·동료 작가 평론·정치 등 다양한 주제를 다룬 산문도 많이 남겼다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Sonetos de la Muerte" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">1914년 산티아고에서 열린 전국 문학 경연대회에서 《Sonetos de la Muerte》(죽음의 소네트)로 1등을 차지하면서 가브리엘라 미스트랄이라는 이름이 널리 알려졌다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Desolación" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">1922년 첫 시집 《Desolación》(황폐)을 출간했다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Ternura" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">1924년에는 어린이를 위한 자장가와 윤무곡을 담은 《Ternura》(다정함)를 냈다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Tala" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">1938년 부에노스아이레스에서 출간한 시집 《Tala》(벌목)는 판매 수익을 스페인 내전으로 부모를 잃은 어린이들에게 기부했다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Lagar" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">마지막 생전 시집 《Lagar》(포도 압착기, 1954)는 전쟁과 조카의 죽음에서 비롯된 슬픔을 담았다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Poema de Chile" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">유고 시집 《Poema de Chile》(칠레의 시, 1967)는 죽은 뒤 칠레로 돌아오는 시인을 화자로 삼아 아타카마 사막의 원주민 소년과 안데스사슴을 동반한 여정을 그렸다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="신지학" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">미스트랄은 신지학을 폭넓게 읽었으며 1925년 재속 프란치스코회(제3회 프란치스코회)의 회원이 되었지만 미사에는 거의 참석하지 않았다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="칠레 국가 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">1945년 라틴아메리카 작가로는 처음이자 여성으로는 다섯 번째로 노벨 문학상을 받았으며, 1951년에는 칠레 국가 문학상도 수상했다.</data>
    </edge>
    <edge source="가오싱젠" target="중화인민공화국" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">가오싱젠</data>
      <data key="d4">중화인민공화국에서 출생한 프랑스의 소설가, 극작가, 비평가, 번역가, 연출가, 화가이다.</data>
    </edge>
    <edge source="가오싱젠" target="프랑스" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">가오싱젠</data>
      <data key="d4">1998년에는 프랑스 시민권을 취득하면서 중국계 프랑스인이 되었다.</data>
    </edge>
    <edge source="가오싱젠" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">가오싱젠</data>
      <data key="d4">해외로 망명한 중국어권 작가로는 사상 처음으로 노벨 문학상 수상자로 선정되었지만 중국에서는 그가 노벨 문학상 수상자로 선정된 것에 비난이 일기도 했다.</data>
    </edge>
    <edge source="가오싱젠" target="중국어" id="WROTE_IN">
      <data key="d2">WROTE_IN</data>
      <data key="d3">가오싱젠</data>
      <data key="d4">그의 작품들은 중국에서 금서로 지정되었다.</data>
    </edge>
    <edge source="가오싱젠" target="중국 공산당" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">가오싱젠</data>
      <data key="d4">1970년부터 1987년까지는 중국 공산당의 당원이었다.</data>
    </edge>
    <edge source="가오싱젠" target="내 할아버지를 위한 낚싯대" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가오싱젠</data>
      <data key="d4">《내 할아버지를 위한 낚싯대 (給我老爺買魚竿)》 (1986년-1990년 작)</data>
    </edge>
    <edge source="가오싱젠" target="영혼의 산" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가오싱젠</data>
      <data key="d4">《영혼의 산 (靈山)》 (1989년 작)</data>
