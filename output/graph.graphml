    <edge source="헨리크 시엔키에비치" target="폴란드" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">헨리크 시엔키에비치</data>
      <data key="d4">폴란드의 소설가이다.</data>
    </edge>
    <edge source="헨리크 시엔키에비치" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">헨리크 시엔키에비치</data>
      <data key="d4">1905년 노벨 문학상을 수상하고 제1차 세계 대전 중 폴란드 독립 운동과 국제적십자사의 구호 활동에 종사하는 동안 스위스에서 객사했다.</data>
    </edge>
    <edge source="헨리크 시엔키에비치" target="레지옹 도뇌르 슈발리에 훈장" id="WON">
      <data key="d2">WON</data>
      <data key="d3">헨리크 시엔키에비치</data>
      <data key="d4">레지옹 도뇌르 슈발리에 훈장(1904년)</data>
    </edge>
    <edge source="헨리크 폰토피단" target="덴마크" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">헨리크 폰토피단</data>
      <data key="d4">덴마크의 노벨상 수상자, 덴마크의 소설가, 프레데리시아 출신</data>
    </edge>
    <edge source="헨리크 폰토피단" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">헨리크 폰토피단</data>
      <data key="d4">카를 아돌프 기엘레루프와 함께 “오늘날 덴마크의 삶을 진실하게 묘사한 공로로” 1917년 노벨 문학상을 공동 수상한</data>
    </edge>
    <edge source="헨리크 폰토피단" target="약속의 땅" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">헨리크 폰토피단</data>
      <data key="d4">폰토피단의 대표 장편인 《약속의 땅》(1891~1895)은 시골 목사가 되려는 이상주의자의 자기기만과 좌절을 다루며</data>
    </edge>
    <edge source="헨리크 폰토피단" target="행운아 페르" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">헨리크 폰토피단</data>
      <data key="d4">자전적 소설 《행운아 페르》(1898~1904)는 종교적 가정과 결별하고 공학자가 되려는 인물의 성공과 귀환을 그린다</data>
    </edge>
    <edge source="헨리크 폰토피단" target="죽은 자의 왕국" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">헨리크 폰토피단</data>
      <data key="d4">《죽은 자의 왕국》(1912~1916)은 민주주의가 정착한 뒤에도 정치적 이상이 쇠퇴하고 자본주의와 언론이 타락하는 덴마크 사회를 묘사한다</data>
    </edge>
    <edge source="헨리크 폰토피단" target="사실주의" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">헨리크 폰토피단</data>
      <data key="d4">덴마크의 사실주의 작가이다.</data>
    </edge>
    <edge source="호세 에체가라이" target="스페인" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">호세 에체가라이</data>
      <data key="d4">호세 에체가라이 이 에이사기레(José Echegaray y Eizaguirre, 1832년 4월 19일 ~ 1916년 9월 14일)는 스페인의 토목 기술자, 수학자, 정치인이자 19세기 후반 스페인을 대표하는 극작가이다.</data>
    </edge>
    <edge source="호세 에체가라이" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">호세 에체가라이</data>
      <data key="d4">그는 1904년에 프랑스의 시인 프레데리크 미스트랄과 함께 노벨 문학상을 수상했으며 스페인인으로는 처음으로 노벨상을 수상했다.</data>
    </edge>
    <edge source="호세 에체가라이" target="광인인가 성인인가" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">호세 에체가라이</data>
      <data key="d4">그의 대표 작품으로 《광인인가 성인인가 (O locura o santidad)》, 《위대한 갈레오토 (El Gran Galeoto)》가 있다.</data>
    </edge>
    <edge source="호세 에체가라이" target="위대한 갈레오토" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">호세 에체가라이</data>
      <data key="d4">그의 대표 작품으로 《광인인가 성인인가 (O locura o santidad)》, 《위대한 갈레오토 (El Gran Galeoto)》가 있다.</data>
    </edge>
    <edge source="호세 에체가라이" target="19세기" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">호세 에체가라이</data>
      <data key="d4">호세 에체가라이 이 에이사기레(José Echegaray y Eizaguirre, 1832년 4월 19일 ~ 1916년 9월 14일)는 스페인의 토목 기술자, 수학자, 정치인이자 19세기 후반 스페인을 대표하는 극작가이다.</data>
    </edge>
