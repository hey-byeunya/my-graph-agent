      <data key="d2">WON</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">라틴아메리카 출신 작가로는 처음으로 1945년 노벨 문학상을 수상했으며, 수상 선정 이유는 “강렬한 감정에서 비롯된 서정시로 자신의 이름을 라틴아메리카 전체의 이상주의적 열망을 상징하게 했다”는 것이었다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="칠레 국가 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">미스트랄은 1945년 라틴아메리카 작가로는 처음이자 여성으로는 다섯 번째로 노벨 문학상을 받았으며, 1951년에는 칠레 국가 문학상도 수상했다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Sonetos de la Muerte" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">1914년 산티아고에서 열린 전국 문학 경연대회에서 《Sonetos de la Muerte》(죽음의 소네트)로 1등을 차지하면서 가브리엘라 미스트랄이라는 이름이 널리 알려졌다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Desolación" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">1922년 첫 시집 《Desolación》(황폐)을 출간했다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Ternura" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">1924년에는 어린이를 위한 자장가와 윤무곡을 담은 《Ternura》(다정함)를 냈다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Tala" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">1938년 부에노스아이레스에서 출간한 시집 《Tala》(벌목)는 판매 수익을 스페인 내전으로 부모를 잃은 어린이들에게 기부했다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Lagar" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">마지막 생전 시집 《Lagar》(포도 압착기, 1954)는 전쟁과 조카의 죽음에서 비롯된 슬픔을 담았다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="Poema de Chile" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">유고 시집 《Poema de Chile》(칠레의 시, 1967)는 죽은 뒤 칠레로 돌아오는 시인을 화자로 삼아 아타카마 사막의 원주민 소년과 안데스사슴을 동반한 여정을 그렸다.</data>
    </edge>
    <edge source="가브리엘라 미스트랄" target="재속 프란치스코회" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">가브리엘라 미스트랄</data>
      <data key="d4">미스트랄은 신지학을 폭넓게 읽었으며 1925년 재속 프란치스코회(제3회 프란치스코회)의 회원이 되었지만 미사에는 거의 참석하지 않았다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="일본" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">가와바타 야스나리(일본어: 川端 康成 (かわばた やすなり), 1899년 6월 14일~1972년 4월 16일)는 일본의 소설가이자 1968년의 노벨 문학상 수상자로, 오사카부 오사카시 기타구의 차화정(此花町, 지금의 덴진바시 부근)에서 태어났다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="노벨 문학상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">가와바타 야스나리|V. S. 나이폴|귄터 그라스|게르하르트 하웁트만|아니 에르노</data>
      <data key="d4">1968년(쇼와 43년)에 일본인 최초로 노벨 문학상을 수상했다. ⏐ 그는 1971년에 맨부커상을, 2001년에 노벨 문학상을 받았다. ⏐ 1999년에 노벨 문학상을 수상하였다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="신감각파" id="BELONGS_TO">
      <data key="d2">BELONGS_TO</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">요코미쓰 리이치 등과 함께 『분게이지다이(文藝時代)』를 창간하여 당시 유럽의 허무주의, 미래파, 표현주의 영향을 받아서 생긴 문학 유파였던 신감각파(新感覺派)의 대표적 작가로서 활약하였다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="이즈의 무희" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">초기에는 왕조문학이나 불교 경전의 영향을 받아 허무한 슬픔과 서정성이 넘치는 작품을 많이 썼다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="설국" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">이후 비현실적인 미의 세계를 구축하는 방향으로 전환해 「설국」을 발표하기에 이르렀다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="천 마리의 종이학" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">그 뒤 「천 마리의 종이학」, 「산소리」 등을 단속적으로 발표하면서, 패전 뒤인 1948년에는 일본펜클럽 제4대 회장으로 취임하였다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="산소리" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">그 뒤 「천 마리의 종이학」, 「산소리」 등을 단속적으로 발표하면서, 패전 뒤인 1948년에는 일본펜클럽 제4대 회장으로 취임하였다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="고도" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">교토 안에 현존하는 유일한 양조장 사사키 주조(佐々木酒造)에서 만든 일본술을 맛보고 "이 술의 풍미야말로 교토의 맛이다"라며 작품 이름을 「고도」라 지었다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="문예간담회상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">1937년 - 「설국」으로 문예간담회상 수상</data>
    </edge>
    <edge source="V. S. 나이폴" target="기쿠치간상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">1944년 - 「고향」, 「석양」 등으로 기쿠치간상 수상</data>
    </edge>
    <edge source="V. S. 나이폴" target="예술원상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">1952년 - 「천 마리의 종이학」으로 예술원상(芸術院賞) 수상</data>
    </edge>
    <edge source="V. S. 나이폴" target="노마 문예상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">1954년 - 「산소리」로 제7회 노마 문예상(野間文芸賞) 수상</data>
    </edge>
    <edge source="V. S. 나이폴" target="마이니치 출판 문화상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">가와바타 야스나리</data>
      <data key="d4">1962년 - 「잠든 미녀」로 제16회 마이니치 출판 문화상(毎日出版文化賞) 수상</data>
    </edge>
    <edge source="V. S. 나이폴" target="트리니다드 토바고" id="NATIONALITY">
      <data key="d2">NATIONALITY</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그는 트리니다드 토바고에서 태어난 인도계 영국인 작가이다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="부커상" id="WON">
      <data key="d2">WON</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그는 1971년에 맨부커상을, 2001년에 노벨 문학상을 받았다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="신비로운 안마사" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《신비로운 안마사 (The Mystic Masseur)》(1957년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="비스와스씨의 집" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《비스와스씨의 집 (A House for Mr. Biswas)》(1961년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="중간의 길" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《중간의 길 (The Middle Passage: Impressions of Five Societies – British, French and Dutch in the West Indies and South America)》(1962년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="자유 국가에서" id="AUTHORED">
      <data key="d2">AUTHORED</data>
      <data key="d3">V. S. 나이폴</data>
      <data key="d4">그의 대표 작품으로 《자유 국가에서 (In a Free State)》(1971년 작) 등이 있다.</data>
    </edge>
    <edge source="V. S. 나이폴" target="게릴라" id="AUTHORED">
