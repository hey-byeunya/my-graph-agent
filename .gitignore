# ── 비밀 (절대 커밋하지 않는다)
.env
.env.*
!.env.example
*.key
*.pem

# ── 파이썬
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 재현 가능한 중간 산출물 (다시 돌리면 만들어진다)
.cache/
data/.raw_cache/

# ── 개발용 도구·설정·산출물 — 제출물을 돌리는 데 필요 없다
#
# 공통점: 지워도 파이프라인이 그대로 돌고, 채점자가 읽을 이유가 없으며,
# 내 작업 환경에서만 의미가 있다.
#
# PLAN.md             : 작업 계획·진행 체크리스트 — 내 작업 기록이다.
#                       제출에 필요한 설계 근거는 REPORT.md 가 담는다
# make_screenshots.py : 문서용 캡처 도구 (playwright 를 따로 깔아야 한다)
# docs/code-review*   : 코드 리뷰 기록 — 작업 과정 산출물
# output/             : 기본은 전부 무시하고, 제출물(REPORT 가 인용하는 산출물)만
#                       아래 '!' 줄로 명시해 올린다. runs.jsonl(실행 로그),
#                       eval_smoke(run_e2e 연막), eval_*_check(--repeat 1 스크래치)
#                       같은 부산물은 따로 적지 않아도 저절로 빠진다.
#                       'output/' 가 아니라 'output/*' 여야 '!' 예외가 먹는다
# .claude/            : 브라우저 미리보기 등 하네스 설정
PLAN.md
make_screenshots.py
docs/code-review*.md
docs/CODE_REVIEW*.md
output/*
!output/graph.graphml
!output/triples.json
!output/build_report.json
!output/index_audit.json
!output/eval.json
!output/eval_hop[0-9]*.json
!output/e2e_run.json
.claude/
.vscode/
.idea/
# .streamlit/ 은 secrets.toml 등 개인 설정이 들어가는 곳이라 막되, 데모 테마
# (config.toml)는 제출물의 일부라 올린다
.streamlit/*
!.streamlit/config.toml
playwright-report/
test-results/
*.log

# ── OS
.DS_Store
Thumbs.db
